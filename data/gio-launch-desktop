#!/bin/sh
# usr/bin/gio-launch-desktop in the AppImage (build-appimage.sh). The bundled GLib starts every program it launches
# (the file manager a FileLauncher opens, a link's browser) as `gio-launch-desktop PROGRAM ARGS...`, found through PATH,
# where AppRun put the AppImage's usr/bin first. Before the real gio-launch-desktop (usr/libexec) runs PROGRAM, this
# gives it the environment it would have had without the AppImage: every variable AppRun listed in
# NEURAL_FORGE_BUNDLE_ENV (by now only PATH) back to its NEURAL_FORGE_ORIG_<NAME> value, or unset when it had none,
# and no NEURAL_FORGE_BUNDLE_ENV or NEURAL_FORGE_ORIG_* left. scripts/test_apprun.sh tests it.
real="$(dirname "$(readlink -f "$0")")/../libexec/gio-launch-desktop"
set -f # the names are split on spaces, never globbed
for name in ${NEURAL_FORGE_BUNDLE_ENV:-}; do
    case "$name" in *[!A-Z0-9_]* | [0-9]* | "") continue ;; esac
    if eval "[ -n \"\${NEURAL_FORGE_ORIG_$name+set}\" ]"; then
        eval "export $name=\"\$NEURAL_FORGE_ORIG_$name\""
    else
        unset "$name"
    fi
done
unset NEURAL_FORGE_BUNDLE_ENV
for name in $(env | sed -n 's/^\(NEURAL_FORGE_ORIG_[A-Z0-9_]*\)=.*/\1/p'); do
    unset "$name"
done
exec "$real" "$@"
