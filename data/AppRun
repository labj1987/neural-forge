#!/usr/bin/env bash
# The AppImage's entry point: build-appimage.sh copies it to the AppDir's root. It checks that the system has the
# libraries the GUI takes from it, then starts the GUI (usr/bin/neural-forge) with its arguments. It changes no
# environment variable: the GUI, and every program it starts, sees the environment the AppImage was started with.
# scripts/test_apprun.sh tests it.
HERE="$(dirname "$(readlink -f "$0")")"

# >>> libcheck: before anything else, make sure the GUI can start. Neural Forge brings no libraries of its own. The
# GUI is linked against glibc, libgcc_s, libxcb, libxkbcommon and libxkbcommon-x11: `ldd -r` on it must report no
# missing library, no missing symbol version (a glibc older than the build's, for one) and no undefined symbol of
# the GUI itself. And it loads by name at run time, where ldd cannot see them, libwayland-client on a Wayland
# session and a graphics loader, Vulkan's or EGL's (libcheck_runtime). A system with a loader but no working driver
# is the GUI's own business: it says so itself. When the GUI cannot start, the reason goes to stderr and, since
# nobody sees stderr when it was started from a menu, to a dialog (zenity, kdialog or a notification).
# LIBCHECK_LOADER, LIBCHECK_LDCONFIG, LIBCHECK_OS_RELEASE, LIBCHECK_OSTREE_BOOTED, LIBCHECK_GLIBC_HAVE and LIBCHECK_DIALOG=none exist for
# the tests. Every name here is a shell variable, never exported.

# libcheck_scan BINARY [loader]: sorts what `ldd -r BINARY` reports into LIBCHECK_LIBS (libraries not found),
# LIBCHECK_GLIBC (the newest GLIBC_x.y version that is needed but missing), LIBCHECK_OTHER (other "not found"
# lines), LIBCHECK_SYMBOLS (undefined symbols of BINARY) and LIBCHECK_RC (ldd's exit status). Without ldd, or with
# "loader" as the second argument, the dynamic loader is asked directly, as ldd -r does (LIBCHECK_LOADER replaces
# it in the tests).
libcheck_scan() {
    local out line rc=0 re='version .GLIBC_([0-9]+(\.[0-9]+)*). not found'
    LIBCHECK_LIBS=(); LIBCHECK_GLIBC=""; LIBCHECK_OTHER=(); LIBCHECK_SYMBOLS=()
    if [[ "${2:-}" == loader ]] || ! command -v ldd >/dev/null 2>&1; then
        if [[ -n "${LIBCHECK_LOADER:-}" ]]; then
            out="$("$LIBCHECK_LOADER" "$1" 2>&1)" || rc=$?
        else
            out="$(LC_ALL=C LD_TRACE_LOADED_OBJECTS=1 LD_WARN=yes LD_BIND_NOW=yes "$1" 2>&1)" || rc=$?
        fi
    else
        out="$(LC_ALL=C ldd -r "$1" 2>&1)" || rc=$?
    fi
    while IFS= read -r line; do
        line="${line#"${line%%[![:space:]]*}"}"
        if [[ "$line" == *"=> not found"* ]]; then
            # Once each: ldd names a library once for every object that needs it.
            [[ " ${LIBCHECK_LIBS[*]} " == *" ${line%% *} "* ]] || LIBCHECK_LIBS+=("${line%% *}")
        elif [[ "$line" =~ $re ]]; then
            if [[ -z "$LIBCHECK_GLIBC" ]] || [[ "$(printf '%s\n' "$LIBCHECK_GLIBC" "${BASH_REMATCH[1]}" | sort -V | tail -n1)" != "$LIBCHECK_GLIBC" ]]; then
                LIBCHECK_GLIBC="${BASH_REMATCH[1]}"
            fi
        elif [[ "$line" == *"not found"* ]]; then
            LIBCHECK_OTHER+=("$line")
        elif [[ "$line" == "undefined symbol: "* ]] && libcheck_ours "$line" "$1"; then
            line="${line#undefined symbol: }"
            LIBCHECK_SYMBOLS+=("${line%%[[:space:],]*}")
        elif [[ "$line" == "symbol "*" version "*" not defined in file "* ]] && libcheck_ours "$line" "$1"; then
            line="${line#symbol }"
            LIBCHECK_SYMBOLS+=("${line%% *}")
        fi
    done <<<"$out"
    LIBCHECK_RC=$rc
}

# libcheck_ours LINE BINARY: whether the object an unresolved-symbol line ends with, "(OBJECT)", is BINARY. A system
# library's own unresolved (lazy) symbol is its business.
libcheck_ours() {
    local obj="${1##*(}"
    [[ "${obj%)}" == "$2" ]]
}

# libcheck_cache: puts the dynamic loader's cache listing (`ldconfig -p`) in LIBCHECK_CACHE, or nothing when there
# is no usable one: no ldconfig, or a cache that does not even list glibc (a system that keeps its libraries
# elsewhere, like NixOS). Without it nothing is said about the run-time libraries.
libcheck_cache() {
    local tool out
    LIBCHECK_CACHE=""
    for tool in "${LIBCHECK_LDCONFIG:-}" ldconfig /sbin/ldconfig /usr/sbin/ldconfig; do
        [[ -n "$tool" ]] || continue
        command -v "$tool" >/dev/null 2>&1 || continue
        out="$("$tool" -p 2>/dev/null)" || continue
        [[ "$out" == *$'\t'"libc.so.6 (libc6,x86-64"* ]] || return 0
        LIBCHECK_CACHE="$out"
        return 0
    done
}

# libcheck_has LIBRARY: whether the loader would find the 64-bit LIBRARY: it is in the cache, or in a directory of
# LD_LIBRARY_PATH.
libcheck_has() {
    local dir
    [[ "$LIBCHECK_CACHE" == *$'\t'"$1 (libc6,x86-64"* ]] && return 0
    local IFS=:
    for dir in ${LD_LIBRARY_PATH:-}; do
        [[ -n "$dir" && -e "$dir/$1" ]] && return 0
    done
    return 1
}

# libcheck_runtime: adds to LIBCHECK_LIBS the missing libraries among those the GUI loads by name:
# libwayland-client.so.0 on a Wayland session, and libvulkan.so.1 with libEGL.so.1 when both are missing (the window
# is drawn with either). LIBCHECK_NOTE gets the sentence that says so.
libcheck_runtime() {
    LIBCHECK_NOTE=""
    libcheck_cache
    [[ -n "$LIBCHECK_CACHE" ]] || return 0
    if [[ -n "${WAYLAND_DISPLAY:-}" ]] && ! libcheck_has libwayland-client.so.0; then
        LIBCHECK_LIBS+=(libwayland-client.so.0)
    fi
    if ! libcheck_has libvulkan.so.1 && ! libcheck_has libEGL.so.1; then
        LIBCHECK_LIBS+=(libvulkan.so.1 libEGL.so.1)
        LIBCHECK_NOTE=" The window is drawn with Vulkan or OpenGL ES, so one of libvulkan.so.1 and libEGL.so.1 is enough."
    fi
}

# libcheck_glibc_version: the system's glibc version, or nothing when it can't be told.
libcheck_glibc_version() {
    local v
    if [[ -n "${LIBCHECK_GLIBC_HAVE:-}" ]]; then
        echo "$LIBCHECK_GLIBC_HAVE"
        return 0
    fi
    v="$(getconf GNU_LIBC_VERSION 2>/dev/null)"
    v="${v#glibc }"
    if [[ -z "$v" ]] && command -v ldd >/dev/null 2>&1; then
        v="$(ldd --version 2>/dev/null | head -n1)"
        v="${v##* }"
    fi
    [[ "$v" =~ ^[0-9]+(\.[0-9]+)+$ ]] && echo "$v"
    return 0
}

# libcheck_package MANAGER LIBRARY: the apt or pacman package that provides LIBRARY, for the libraries the GUI takes
# from the system; nothing for any other library.
libcheck_package() {
    local so apt pacman
    while read -r so apt pacman; do
        [[ "$so" == "$2" ]] || continue
        if [[ "$1" == apt ]]; then echo "$apt"; else echo "$pacman"; fi
        return 0
    done <<'TABLE'
libxcb.so.1 libxcb1 libxcb
libxkbcommon.so.0 libxkbcommon0 libxkbcommon
libxkbcommon-x11.so.0 libxkbcommon-x11-0 libxkbcommon-x11
libwayland-client.so.0 libwayland-client0 wayland
libvulkan.so.1 libvulkan1 vulkan-icd-loader
libEGL.so.1 libegl1 libglvnd
libgcc_s.so.1 libgcc-s1 gcc-libs
TABLE
}

# libcheck_install_hint LIBRARY...: how to install the packages that provide LIBRARY..., as one or two sentences,
# for the system's package manager; nothing for an unknown distribution. dnf and zypper install by library name
# (rpm's provides); apt and pacman get the package names of the usual system libraries, and the command that finds
# the package for any other one.
libcheck_install_hint() {
    local f="${LIBCHECK_OS_RELEASE:-/etc/os-release}" ids id mgr="" cmd lib pkg out=""
    local pkgs=() unknown=()
    [[ -r "$f" ]] || return 0
    # shellcheck disable=SC1090
    ids="$(. "$f" 2>/dev/null; echo "${ID:-} ${ID_LIKE:-}")"
    for id in $ids; do
        case "$id" in
            fedora|rhel|centos|rocky|almalinux) mgr=dnf ;;
            opensuse*|suse|sles) mgr=zypper ;;
            debian|ubuntu) mgr=apt ;;
            arch) mgr=pacman ;;
            *) continue ;;
        esac
        break
    done
    case "$mgr" in
        dnf|zypper)
            # An image-based Fedora (Silverblue, Kinoite, Bazzite, ...) layers packages with rpm-ostree, not dnf.
            if [[ "$mgr" == dnf && -e "${LIBCHECK_OSTREE_BOOTED:-/run/ostree-booted}" ]]; then
                cmd="rpm-ostree install"
            else
                cmd="sudo $mgr install"
            fi
            for lib in "$@"; do cmd+=" '$lib()(64bit)'"; done
            if [[ "$cmd" == rpm-ostree* ]]; then
                echo "Install them with: $cmd, and restart the computer."
            else
                echo "Install them with: $cmd."
            fi
            ;;
        apt|pacman)
            for lib in "$@"; do
                pkg="$(libcheck_package "$mgr" "$lib")"
                if [[ -z "$pkg" ]]; then
                    unknown+=("$lib")
                elif [[ " ${pkgs[*]} " != *" $pkg "* ]]; then
                    pkgs+=("$pkg")
                fi
            done
            if ((${#pkgs[@]})); then
                if [[ "$mgr" == apt ]]; then cmd="sudo apt install"; else cmd="sudo pacman -S"; fi
                out="Install them with: $cmd ${pkgs[*]}."
            fi
            if ((${#unknown[@]})); then
                if [[ "$mgr" == apt ]]; then cmd="apt-file search"; else cmd="pacman -F"; fi
                if ((${#pkgs[@]})); then lib="each of the others"; else lib="each of them"; fi
                out+="${out:+ }Find the package that provides $lib with:"
                for lib in "${unknown[@]}"; do out+=" $cmd $lib;"; done
                out="${out%;}."
            fi
            echo "$out"
            ;;
    esac
}

# libcheck_list ITEM...: "a, b, c".
libcheck_list() {
    local IFS=,
    local s="$*"
    echo "${s//,/, }"
}

# libcheck_plain TEXT: TEXT with nothing kdialog (Qt rich text) or a notification server (body markup) would take as
# markup: no &, < or >.
libcheck_plain() {
    local t="${1//&/and}"
    t="${t//</‹}"
    echo "${t//>/›}"
}

# libcheck_gvariant TEXT: TEXT as a GVariant text-format string (single-quoted; \\, ', newline, tab and carriage return
# escaped), which is how gdbus reads its arguments.
libcheck_gvariant() {
    local t
    # Unquoted on purpose: inside double quotes $'\n' is not a newline.
    t=${1//\\/\\\\}
    t=${t//\'/\\\'}
    t=${t//$'\n'/\\n}
    t=${t//$'\t'/\\t}
    t=${t//$'\r'/\\r}
    printf "'%s'" "$t"
}

# libcheck_no_display TEXT: whether a dialog program's stderr TEXT says it could not open the display.
libcheck_no_display() {
    [[ "$1" == *"Failed to open display"* || "$1" == *"annot open display"* ]]
}

# libcheck_dialog PROGRAM ARG...: runs a dialog program; 0 when it showed its message (it ended with 0 or 1, as it does
# once its dialog was closed or confirmed, and did not say it could not open the display, which also ends zenity with
# 1). Its stderr goes to a temporary file read once it has ended: reading a pipe to its end would also wait for anything
# it left running.
libcheck_dialog() {
    local rc=0 errf err=""
    errf="$(mktemp 2>/dev/null)" || errf=""
    "$@" </dev/null >/dev/null 2>"${errf:-/dev/null}" || rc=$?
    if [[ -n "$errf" ]]; then
        err="$(<"$errf")"
        rm -f "$errf"
    fi
    ((rc <= 1)) && ! libcheck_no_display "$err"
}

# libcheck_show TITLE TEXT: TEXT on stderr, and in the first dialog tool that can show it when there is a display.
# zenity and kdialog count as shown when libcheck_dialog says so; anything else (127: not runnable, e.g. a zenity built
# on the same missing libraries; no display) tries the next.
libcheck_show() {
    printf '%s: %s\n' "$1" "$2" >&2
    [[ "${LIBCHECK_DIALOG:-}" == none ]] && return 0
    [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || return 0
    if command -v zenity >/dev/null 2>&1; then
        libcheck_dialog zenity --error --no-markup --title="$1" --text="$2" --width=460 && return 0
    fi
    if command -v kdialog >/dev/null 2>&1; then
        libcheck_dialog kdialog --error "$(libcheck_plain "$2")" --title "$1" && return 0
    fi
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical -t 0 -a "$1" "$1" "$(libcheck_plain "$2")" >/dev/null 2>&1 && return 0
    fi
    # A desktop with none of those (a stock COSMIC, for one) still has a notification service: asked directly.
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications \
            --method org.freedesktop.Notifications.Notify -- "$(libcheck_gvariant "$1")" 'uint32 0' "''" "$(libcheck_gvariant "$1")" \
            "$(libcheck_gvariant "$(libcheck_plain "$2")")" '@as []' "{'urgency': <byte 2>}" 'int32 0' \
            >/dev/null 2>&1 && return 0
    fi
    if command -v xmessage >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
        xmessage -center "$1: $2" >/dev/null 2>&1
    fi
    return 0
}

# libcheck_run NAME BINARY: returns 1 (after showing why) when BINARY can't start here.
libcheck_run() {
    local msg have hint more=""
    libcheck_scan "$2"
    if ((LIBCHECK_RC != 0)) && [[ -z "$LIBCHECK_GLIBC" ]] && ((${#LIBCHECK_LIBS[@]} + ${#LIBCHECK_OTHER[@]} + ${#LIBCHECK_SYMBOLS[@]} == 0)); then
        # ldd failed without saying why: ask the loader itself, and stop only if it names a problem.
        libcheck_scan "$2" loader
    fi
    LIBCHECK_NOTE=""
    [[ -n "$LIBCHECK_GLIBC" ]] || libcheck_runtime
    if [[ -n "$LIBCHECK_GLIBC" ]]; then
        have="$(libcheck_glibc_version)"
        msg="$1 can't start: it needs glibc $LIBCHECK_GLIBC or newer; this system has ${have:-an older one}."
        msg+=" This system is too old for this version of $1."
    elif ((${#LIBCHECK_LIBS[@]})); then
        msg="$1 can't start because these system libraries are missing: $(libcheck_list "${LIBCHECK_LIBS[@]}")."
        msg+=" $1 takes them from the system (windowing and graphics libraries every desktop normally has).$LIBCHECK_NOTE"
        hint="$(libcheck_install_hint "${LIBCHECK_LIBS[@]}")"
        if [[ -n "$hint" ]]; then
            msg+=" $hint Then start $1 again."
        else
            msg+=" Install the packages that provide them with your package manager, then start $1 again."
        fi
    elif ((${#LIBCHECK_SYMBOLS[@]} + ${#LIBCHECK_OTHER[@]})); then
        if ((${#LIBCHECK_SYMBOLS[@]} > 3)); then more=" and $((${#LIBCHECK_SYMBOLS[@]} - 3)) more"; fi
        if ((${#LIBCHECK_SYMBOLS[@]})); then
            msg="$1 can't start because the system's libraries are too old: they lack $(libcheck_list "${LIBCHECK_SYMBOLS[@]:0:3}")$more."
        else
            msg="$1 can't start because the system's libraries are too old: ${LIBCHECK_OTHER[0]}."
        fi
        msg+=" Update the system, then start $1 again."
    else
        return 0
    fi
    libcheck_show "$1" "$msg"
    return 1
}
# <<< libcheck

libcheck_run "Neural Forge" "$HERE/usr/bin/neural-forge" || exit 1
exec "$HERE/usr/bin/neural-forge" "$@"
