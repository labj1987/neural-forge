#!/usr/bin/env bash
# The AppImage's entry point: build-appimage.sh copies it to the AppDir's root.
HERE="$(dirname "$(readlink -f "$0")")"

# ── Which GUI: the host's GTK or the bundled one ─────────────────────
# The GUI ships twice (build-appimage.sh): usr/bin/neural-forge as built, which uses the host's GTK 4 and
# libadwaita, and usr/bin/bundled/neural-forge, which finds the GTK runtime bundled in the AppImage through its rpath.
# The host copy runs whenever the host's libraries resolve it completely (`ldd -r`: no library or symbol version
# missing, no symbol undefined), so an up-to-date desktop keeps its newer libadwaita (accent colours, newer widgets);
# otherwise, or without ldd to ask (or when ldd itself fails), the bundled copy. NEURAL_FORGE_GTK=host or =bundled forces one. One line on
# stderr says which, and why.
nf_host_problem() {
    local out missing refs
    command -v ldd >/dev/null 2>&1 || { echo "no ldd to check the host's libraries"; return 0; }
    out="$(LC_ALL=C ldd -r "$1" 2>&1)" || { echo "ldd could not check the host's libraries"; return 0; }
    if grep -q 'not found' <<<"$out"; then
        missing="$(sed -n -e 's/^[[:space:]]*\([^[:space:]]*\) => not found.*/\1/p' \
            -e "s/.*version \`\([^']*\)' not found.*/\1/p" <<<"$out" | sort -u | paste -sd, - | sed 's/,/, /g')"
        echo "the host lacks ${missing:-a library}"
        return 0
    fi
    # Only symbols the GUI itself needs: the dynamic loader names the object that refers to each one, in brackets at
    # the end of the line ("undefined symbol: NAME[, version V]<tab>(OBJECT)", or "symbol NAME version V not defined
    # in file LIB with link time reference<tab>(OBJECT)"). A host library's own unresolved lazy symbols are its business.
    refs="$(grep -E 'undefined symbol: |symbol .* not defined in file ' <<<"$out" | grep -cF "($1)")"
    [ "$refs" -eq 0 ] || echo "the host's libraries lack $refs symbols the GUI needs"
    return 0
}
case "${NEURAL_FORGE_GTK:-}" in
    host) nf_gtk=host; nf_why="NEURAL_FORGE_GTK=host" ;;
    bundled) nf_gtk=bundled; nf_why="NEURAL_FORGE_GTK=bundled" ;;
    *)
        nf_why="$(nf_host_problem "$HERE/usr/bin/neural-forge")"
        if [ -n "$nf_why" ]; then nf_gtk=bundled; else nf_gtk=host; nf_why="the host's GTK 4 and libadwaita resolve"; fi
        [ -z "${NEURAL_FORGE_GTK:-}" ] || nf_why="$nf_why; NEURAL_FORGE_GTK=$NEURAL_FORGE_GTK is neither host nor bundled"
        ;;
esac
printf 'neural-forge: GTK: %s (%s)\n' "$nf_gtk" "$nf_why" >&2
unset nf_why

# ── Libraries the bundled GUI takes from the system ──────────────────
# The bundled copy brings GTK 4 and libadwaita but takes from the system what every desktop has: glibc, the graphics
# stack (OpenGL/EGL, DRM), X11/xcb and Wayland client libraries, fonts (fontconfig, freetype, harfbuzz, fribidi),
# zlib and expat. When one of those does not resolve, the dynamic loader ends it with one line on stderr, which nobody
# sees when it was started from a menu: name the missing libraries in a dialog where one can be shown, and stop.
nf_missing_libraries() {
    command -v ldd >/dev/null 2>&1 || return 0
    LC_ALL=C ldd "$1" 2>/dev/null | awk '$2 == "=>" && $3 == "not" && $4 == "found" { print $1 }' | sort -u
}
nf_show_error() {
    local title="$1" text="$2" rc
    printf '%s\n\n%s\n' "$title" "$text" >&2
    [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ] || return 0
    # zenity and kdialog exit 0 or 1 once their dialog was shown (closed or confirmed); anything else (127: not
    # runnable, e.g. a zenity built on the same missing libraries) tries the next.
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --no-markup --title="$title" --text="$title"$'\n\n'"$text" 2>/dev/null; rc=$?
        [ "$rc" -le 1 ] && return 0
    fi
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "$title" --error "$text" 2>/dev/null; rc=$?
        [ "$rc" -le 1 ] && return 0
    fi
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --urgency=critical --app-name="Neural Forge" "$title" "$text" 2>/dev/null || true
    fi
    return 0
}

# ── What AppRun changes in the environment ───────────────────────────
# Every variable AppRun changes is named in NEURAL_FORGE_BUNDLE_ENV, with its earlier value in NEURAL_FORGE_ORIG_<NAME>
# (left unset when it had none): the GUI puts those back for every program it starts, and for itself once GLib and GTK
# have read them (neural_forge_supervisor::host_env). PATH gets the AppImage's usr/bin first, for either copy (the
# bundled GIO finds its gio-launch-desktop there).
unset NEURAL_FORGE_BUNDLE_ENV "${!NEURAL_FORGE_ORIG_@}"
nf_save() {
    local var
    for var in "$@"; do
        NEURAL_FORGE_BUNDLE_ENV="${NEURAL_FORGE_BUNDLE_ENV:+$NEURAL_FORGE_BUNDLE_ENV }$var"
        if [ -n "${!var+set}" ]; then
            export "NEURAL_FORGE_ORIG_$var=${!var}"
        else
            unset "NEURAL_FORGE_ORIG_$var"
        fi
    done
    export NEURAL_FORGE_BUNDLE_ENV
}

# The bundled GTK's environment: its own modules, image loaders and schemas (build-appimage.sh, bundle_gtk_runtime),
# and none of the host's GTK or GIO module paths, whose modules are built for another GTK. The host copy gets none of
# this. The pixbuf directory's version is the one build-appimage.sh checks.
bundle_env() {
    nf_save GTK_EXE_PREFIX GTK_PATH GDK_PIXBUF_MODULE_FILE GIO_MODULE_DIR GIO_EXTRA_MODULES GSETTINGS_SCHEMA_DIR
    unset GTK_PATH GIO_EXTRA_MODULES
    export GTK_EXE_PREFIX="$1/usr"
    export GDK_PIXBUF_MODULE_FILE="$1/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache"
    export GIO_MODULE_DIR="$1/usr/lib/gio/modules"
    export GSETTINGS_SCHEMA_DIR="$1/usr/share/glib-2.0/schemas${GSETTINGS_SCHEMA_DIR:+:$GSETTINGS_SCHEMA_DIR}"
}

nf_save PATH
export PATH="$HERE/usr/bin:$PATH"
if [ "$nf_gtk" = host ]; then
    unset nf_gtk
    exec "$HERE/usr/bin/neural-forge" "$@"
fi
unset nf_gtk

nf_missing="$(nf_missing_libraries "$HERE/usr/bin/bundled/neural-forge")"
if [ -n "$nf_missing" ]; then
    nf_list="$(printf '%s' "$nf_missing" | paste -sd, - | sed 's/,/, /g')"
    nf_dnf="$(printf '%s' "$nf_missing" | sed "s/.*/'&()(64bit)'/" | paste -sd' ' -)"
    nf_show_error "Neural Forge cannot start: libraries are missing" "These libraries it needs are not installed: $nf_list.

Neural Forge brings GTK 4 and libadwaita with it, but takes these from the system: graphics, windowing and font libraries every desktop normally has. Install the packages that provide them with the package manager (on Fedora and openSUSE by library name: sudo dnf install $nf_dnf), then start Neural Forge again."
    exit 1
fi
unset nf_missing

bundle_env "$HERE"
exec "$HERE/usr/bin/bundled/neural-forge" "$@"
