<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.labj1987.NeuralForge</id>
  <name>Neural Forge</name>
  <summary>DLSS 5 Neural Rendering settings and helper manager</summary>
  <url type="homepage">https://github.com/labj1987/NeuralForge</url>
  <developer id="io.github.labj1987"><name>Linnard Alex Brown Jr.</name></developer>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      A Vulkan implicit layer and settings GUI for running NVIDIA DLSS 5 Neural
      Rendering on native Linux and Proton games, with the Windows-side NGX model
      running under Wine/Proton.
    </p>
  </description>
  <launchable type="desktop-id">io.github.labj1987.NeuralForge.desktop</launchable>
  <provides>
    <binary>neuralforge</binary>
    <binary>neuralforge-cli</binary>
  </provides>
  <screenshots>
    <screenshot type="default">
      <caption>Settings window with Model, Motion, Composition, Debug, Status, and Setup tabs</caption>
      <image>https://raw.githubusercontent.com/labj1987/NeuralForge/main/screenshots/settings.png</image>
    </screenshot>
    <screenshot>
      <caption>Setup tab: NGX binaries status, compatibility tool picker, Steam install and launch-option generator</caption>
      <image>https://raw.githubusercontent.com/labj1987/NeuralForge/main/screenshots/setup.png</image>
    </screenshot>
  </screenshots>
