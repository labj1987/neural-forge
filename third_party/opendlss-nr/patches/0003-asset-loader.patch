+
+// A PTX file through the asset loader when one is set (name without ".ptx"), else from the directory.
+bool ptxAvailable(const std::string& directory, const std::string& file) {
+  if (AssetLoader loader = assetLoader()) {
+    const uint8_t* data = nullptr; size_t size = 0;
+    return loader("ptx", file.substr(0, file.size() - 4).c_str(), &data, &size);
+  }
+  return std::ifstream(directory + "/" + file).good();
+}
+
+std::string readPtx(const std::string& directory, const std::string& file) {
+  if (AssetLoader loader = assetLoader()) {
+    const uint8_t* data = nullptr; size_t size = 0;
+    if (!loader("ptx", file.substr(0, file.size() - 4).c_str(), &data, &size)) throw std::runtime_error("missing PTX kernel " + file);
+    return std::string(reinterpret_cast<const char*>(data), size);
+  }
+  std::ifstream in(directory + "/" + file);
+  if (!in) throw std::runtime_error("cannot read PTX kernel " + directory + "/" + file);
+  std::stringstream buffer; buffer << in.rdbuf();
+  return buffer.str();
+}
