#version 450
// Reduced model resolution before the upscaler (docs/ARCHITECTURE.md 4.11): the network's answer at
// its own extent turned into an answer at the render extent, recorded after the network's frame. The
// network's edit, in the edit cache's representation (log2((v_answer + eps) / (v_input + eps)) per
// channel in the exposure-normalised v, clamped like the cache's: the luma within +-1.5 stops, each
// channel within 1 stop of it), is enlarged by a joint bilateral upsample guided by the full-resolution
// frame: the four bilinear taps of the model texels around the pixel, each weighted by its bilinear
// weight times exp(-((luma_full - luma_model) / sigma_luma)^2) (the encoded pictures' luma) and,
// with depth, exp(-(log2(z_full / z_model) / sigma_depth)^2) (z: the cache's pseudo-linear depth; the
// model texel's from the render pixel at its centre); plain bilinear where the weights all but vanish
// (sum <= 1e-4). The pixel's own v times 2^edit is encoded (preupscale_encode.comp's curve) into the
// answer the write-back decodes with its own rules, so the decode, its clamped-highlight rule and the
// edit cache's capture are unchanged. Upstream's JBU (optiscaler-dlss5, PreSrReduced) weighs by luma
// only, with sigma 0.08; the depth term is this project's.
//
// Shares the set layout and the push constants with preupscale_reduce.comp (see there).
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D u_colour;
// The encode's picture (render padded extent), GENERAL: the guide's luma.
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D u_encoded;
layout(set = 0, binding = 2, std430) readonly buffer Exposure { uint bits; } u_exposure;
// The network's input (model padded extent), GENERAL.
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D u_small;
// The network's answer (native_composite.comp's: packed half4 rows of the model padded width) and the
// one written here (rows of the render padded width), for preupscale_decode.comp.
layout(set = 0, binding = 6, std430) readonly buffer AnswerSmall { uvec2 texel[]; } u_answer_small;
layout(set = 0, binding = 7, std430) writeonly buffer AnswerFull { uvec2 texel[]; } u_answer_full;
// DLSS's depth as the capture copied it (`native::DepthCopy`): raw texels, p.depth_kind says how.
layout(set = 0, binding = 8, std430) readonly buffer Depth { uint raw[]; } u_depth;

layout(push_constant) uniform Params {
  uvec2 size;
  uvec2 padded;
  uvec2 model;
  uvec2 model_padded;
  float paper_white;
  uint depth_kind;
  uint flags;
  float sigma_luma;
  float sigma_depth;
} p;

const float KNEE = 0.75;
const float K = 5.770780;
const float EPS = 1.0 / 512.0;
const float MAX_LUMA_EDIT = 1.5;
const float CHROMA_STOPS = 1.0;
const uint F_REVERSE_Z = 1u;
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

bool exposure_ok(float e) {
  return e > 1e-6 && e < 65504.0;
}

float shoulder(float v) {
  return v <= KNEE ? v : KNEE + 0.25 * (1.0 - exp(-K * (v - KNEE)));
}

float srgb_oetf(float c) {
  c = clamp(c, 0.0, 1.0);
  return c <= 0.0031308 ? 12.92 * c : 1.055 * pow(c, 1.0 / 2.4) - 0.055;
}

float srgb_eotf(float s) {
  s = clamp(s, 0.0, 1.0);
  return s <= 0.04045 ? s / 12.92 : pow((s + 0.055) / 1.055, 2.4);
}

float shoulder_inverse(float y) {
  y = min(y, 1.0 - 1e-4);
  return y >= KNEE ? KNEE - log(1.0 - (y - KNEE) / 0.25) / K : y;
}

// The model domain to v (the decode's curve without the exposure).
vec3 to_v(vec3 s) {
  return vec3(shoulder_inverse(srgb_eotf(s.r)), shoulder_inverse(srgb_eotf(s.g)), shoulder_inverse(srgb_eotf(s.b)));
}

// The edit cache's clamp_edit.
vec3 clamp_edit(vec3 e) {
  float l = dot(e, LUMA);
  float lc = clamp(l, -MAX_LUMA_EDIT, MAX_LUMA_EDIT);
  e = e + (lc - l);
  return clamp(e, vec3(lc - CHROMA_STOPS), vec3(lc + CHROMA_STOPS));
}

float device_depth(uint i) {
  if (p.depth_kind == 3u) {
    uint word = u_depth.raw[i >> 1u];
    return float((i & 1u) == 0u ? word & 0xffffu : word >> 16u) / 65535.0;
  }
  uint raw = u_depth.raw[i];
  return p.depth_kind == 2u ? float(raw & 0x00ffffffu) / 16777215.0 : uintBitsToFloat(raw);
}

// The cache's lin_depth: proportional to view depth.
float lin_depth(uvec2 xy) {
  float d = device_depth(xy.y * p.size.x + xy.x);
  return 1.0 / max((p.flags & F_REVERSE_Z) != 0u ? d : 1.0 - d, 1e-7);
}

void main() {
  uvec2 id = gl_GlobalInvocationID.xy;
  if (any(greaterThanEqual(id, p.padded))) return;
  float e = unpackHalf2x16(u_exposure.bits).x;
  // The decode writes nothing with an unusable exposure.
  if (!exposure_ok(e)) return;
  uvec2 xy = min(id, p.size - 1u);
  float scale = e / p.paper_white;
  vec3 scene = imageLoad(u_colour, ivec2(xy)).rgb;
  scene = clamp(mix(scene, vec3(0.0), isnan(scene)), 0.0, 65504.0);
  vec3 v = min(scene * scale, vec3(64.0));
  float luma_full = dot(imageLoad(u_encoded, ivec2(xy)).rgb, LUMA);
  bool depth = p.depth_kind != 0u;
  float z_full = depth ? lin_depth(xy) : 1.0;
  vec2 ratio = vec2(p.size) / vec2(p.model);
  vec2 at = (vec2(xy) + 0.5) / ratio - 0.5;
  vec2 base = floor(at);
  vec2 f = at - base;
  vec3 sum = vec3(0.0);
  vec3 plain = vec3(0.0);
  float wsum = 0.0;
  for (int j = 0; j < 4; j++) {
    ivec2 offset = ivec2(j & 1, j >> 1);
    uvec2 t = uvec2(clamp(ivec2(base) + offset, ivec2(0), ivec2(p.model) - 1));
    float wb = (offset.x == 1 ? f.x : 1.0 - f.x) * (offset.y == 1 ? f.y : 1.0 - f.y);
    vec3 proxy = imageLoad(u_small, ivec2(t)).rgb;
    uvec2 packed = u_answer_small.texel[t.y * p.model_padded.x + t.x];
    vec3 answer = vec3(unpackHalf2x16(packed.x), unpackHalf2x16(packed.y).x);
    vec3 edit = clamp_edit(log2((to_v(answer) + EPS) / (to_v(proxy) + EPS)));
    float dl = (luma_full - dot(proxy, LUMA)) / p.sigma_luma;
    float w = wb * exp(-dl * dl);
    if (depth) {
      uvec2 centre = min(uvec2((vec2(t) + 0.5) * ratio), p.size - 1u);
      float dz = log2(z_full / lin_depth(centre)) / p.sigma_depth;
      w *= exp(-dz * dz);
    }
    sum += edit * w;
    wsum += w;
    plain += edit * wb;
  }
  vec3 edit = wsum > 1e-4 ? sum / wsum : plain;
  vec3 out_v = max((v + EPS) * exp2(edit) - EPS, vec3(0.0));
  vec3 answer = vec3(srgb_oetf(shoulder(out_v.r)), srgb_oetf(shoulder(out_v.g)), srgb_oetf(shoulder(out_v.b)));
  u_answer_full.texel[id.y * p.padded.x + id.x] = uvec2(packHalf2x16(answer.rg), packHalf2x16(vec2(answer.b, 1.0)));
}
