#version 450
// The composition pass: blends the model's answer onto the frame.
//
// A hand-translated GLSL expression of crates/layer/src/composition/color.rs's
// `upgrade_tone_map`/`gamut_compress_reversible`, wired into a live compute dispatch
// (`composition::gpu`) as of 2026-09-10 -- kept in sync by hand with `color.rs` (GLSL
// and Rust can't literally share source) and, for the sRGB encode/decode this file
// adds itself below, with `composition::apply`'s `srgb_decode`/`srgb_encode`, the
// already-real-hardware-verified CPU reference this shader is the GPU twin of (see the
// layer crate's `CLAUDE.md` entry for that verification).
//
// Bindings match the transport this pass reads/writes: the original frame (capture),
// the proxy the model was shown, the model's raw answer, and the composed output.
// `rgba8`, not `rgba16f`: the real, default, only-currently-supported proxy format is
// `RGBA8` (see `neural_forge_protocol::enums::proxy_format`) -- storage-image `imageLoad`/
// `imageStore` never apply an sRGB curve regardless of format (that is exclusively a
// sampled-image-plus-sampler feature per the Vulkan spec), so this shader does the
// same explicit sRGB decode/encode `composition::apply` already does on the CPU,
// rather than silently operating on gamma-encoded bytes as if they were linear.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba8) uniform readonly image2D u_original;
layout(binding = 1, rgba8) uniform readonly image2D u_proxy;
layout(binding = 2, rgba8) uniform readonly image2D u_model_answer;
layout(binding = 3, rgba8) uniform writeonly image2D u_output;

// IEC 61966-2-1 sRGB EOTF/OETF -- the exact same formulas as
// `composition::apply`'s `srgb_decode`/`srgb_encode`, which is the CPU reference this
// shader must keep matching.
vec3 SrgbDecode(vec3 c) {
  bvec3 lo = lessThanEqual(c, vec3(0.04045));
  vec3 hi = pow((c + 0.055) / 1.055, vec3(2.4));
  return mix(hi, c / 12.92, lo);
}

vec3 SrgbEncode(vec3 c) {
  c = clamp(c, 0.0, 1.0);
  bvec3 lo = lessThanEqual(c, vec3(0.0031308));
  vec3 hi = 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055;
  return clamp(mix(hi, c * 12.92, lo), 0.0, 1.0);
}

layout(push_constant) uniform Params {
  float colour_strength;   // 0 = luminance-only, 1 = fully hue-corrected
  float transfer_strength; // 0 = original frame untouched, 1 = full transfer
  float max_ratio;         // clamp on the rescale ratio (near-black proxy guard)
  // Non-zero when the real captured/answer bytes uploaded into u_original/u_proxy/
  // u_model_answer are B,G,R,A order (a real B8G8R8A8 swapchain), not R,G,B,A --
  // these storage images are always declared `rgba8` above regardless (GLSL/SPIR-V
  // storage image formats have no separate BGR variant), so a BGR-order upload's
  // "red" slot is really blue and vice versa. Found 2026-09-11: this shader's own
  // math was silently reading/writing swapped channels on real hardware (this
  // machine's real swapchain format), producing a visible, uniform blue tint on
  // every composited frame -- see `swapchain::is_bgr_order`'s doc comment (Rust
  // side) for the full story.
  uint bgr_order;
  // 0: the classic ratio-transfer (`UpgradeToneMap`), used by the sync/one-shot
  // dispatch path where `proxy` and `original` are not usually bit-identical.
  // 1: guarded-additive, used by the async held-answer path when the proxy is NOT
  // encoded -- see the comment
  // 2: the encoded-proxy ratio transfer, used whenever the capture leg ran the
  // encode (the normal path on hardware that supports it)
  // where it's read, below, for why that path needs a different formula.
  uint mode;
  // Mode 2 only. 0 = off (the ratio is taken per pixel, as before), 1 = full guard: where the
  // frame has moved since the one the model answered, the relighting ratio comes from the
  // neighbourhood instead of the pixel, so a stale answer cannot paste its detail (a pale
  // copy of old edges and text) onto content that has since moved. See the ghost-guard block.
  float ghost_guard;
  // Comparison views (upstream `dlssnr.hlsl` gCompare*): 0 off, 1 side by side (each half shows
  // the whole frame, letterboxed; zoom 1 fits, 2 fills), 2 wipe at `compare_split` (0..1).
  // `compare_swap` puts the original on the other side. Both halves are the same frame: the
  // present is synchronous, so the answer and the frame it is composed onto match.
  uint compare_mode;
  float compare_split;
  float compare_zoom;
  uint compare_swap;
  // Mode 2. How far the model may move a pixel's colour, as a fraction of the pixel's own
  // luminance (upstream `gColourTrust`, default 2): corrections within it pass whole, larger ones
  // (edge fringing) are shortened, never reversed. 0 turns the model's colour off.
  float colour_trust;
  // Mode 2. 0..1: how much of the relighting ratio is taken from the neighbourhood instead of the
  // pixel (upstream `gRatioSmooth`, default 1). Removes pixel-to-pixel speckle from the ratio while
  // the frame keeps its own fine detail.
  float ratio_smooth;
  // Mode 2, only when `model_small`: how the model's answer comes back when it worked below the
  // frame's size (upstream `gTransfer`). The proxy input then holds the small proxy the model
  // was shown, enlarged the same way as its answer, so `model - proxy` is its edit.
  //   0 classic: the ratio of the enlarged answer to the enlarged proxy
  //   1 matched residual: the edit laid on the frame's own full-resolution proxy
  //   2 native + edit: the frame's own pixels plus the edit (sharpest for text and geometry)
  uint transfer;
  uint model_small;
  // The divisor the proxy encode used (manual or measured white point). The model answered in
  // that encoded space -- frame / white_point, then the knee -- so the proxy it is compared with
  // must be in the same space.
  float white_point;
} params;

float Luminance(vec3 rgb) {
  return dot(rgb, vec3(0.2126, 0.7152, 0.0722));
}

// Bjorn Ottosson's published OkLab matrices (bottosson.github.io/posts/oklab/),
// identical to what crates/layer/src/composition/color.rs uses (see that file for
// why these specifically are not RenoDX's own work despite being cross-checked
// against RenoDX's MIT-licensed oklab.hlsl).
const mat3 LINEAR_SRGB_TO_OKLAB_LMS = mat3(
    0.4122214708, 0.2119034982, 0.0883024619,
    0.5363325363, 0.6806995451, 0.2817188376,
    0.0514459929, 0.1073969566, 0.6299787005);
const mat3 OKLAB_LMS_TO_OKLAB = mat3(
    0.2104542553, 1.9779984951, 0.0259040371,
    0.7936177850, -2.4285922050, 0.7827717662,
    -0.0040720468, 0.4505937099, -0.8086757660);
const mat3 OKLAB_TO_OKLAB_LMS = mat3(
    1.0, 1.0, 1.0,
    0.3963377774, -0.1055613458, -0.0894841775,
    0.2158037573, -0.0638541728, -1.2914855480);
const mat3 OKLAB_LMS_TO_LINEAR_SRGB = mat3(
    4.0767416621, -1.2684380046, -0.0041960863,
    -3.3077115913, 2.6097574011, -0.7034186147,
    0.2309699292, -0.3413193965, 1.7076147010);

vec3 OklabFromLinearSrgb(vec3 rgb) {
  vec3 lms = LINEAR_SRGB_TO_OKLAB_LMS * rgb;
  // Must compute the per-component cube root as a complete vector *before* the
  // matrix multiply -- `M * sign(lms) * pow(abs(lms), 1/3)` without these parens
  // evaluates left-to-right (mat3*vec3, then component-wise vec3*vec3), which
  // multiplies the matrix by `sign(lms)` alone first, not by the cube-rooted vector.
  // Confirmed by a real GPU-vs-CPU-reference test (`composition::gpu`'s own
  // `#[test]`): this exact bug was caught by that test diverging by up to 90/255
  // before this fix, matching to within float rounding after it.
  vec3 cbrt_lms = sign(lms) * pow(abs(lms), vec3(1.0 / 3.0));
  return OKLAB_LMS_TO_OKLAB * cbrt_lms;
}

vec3 LinearSrgbFromOklab(vec3 oklab) {
  vec3 lms = OKLAB_TO_OKLAB_LMS * oklab;
  return OKLAB_LMS_TO_LINEAR_SRGB * (lms * lms * lms);
}

// Standard sRGB-linear<->XYZ (D65) and Hunt-Pointer-Estevez XYZ->LMS -- see the Rust
// module doc comment; textbook color science, not RenoDX's or anyone's in particular.
const mat3 LINEAR_SRGB_TO_XYZ = mat3(
    0.4124564, 0.2126729, 0.0193339,
    0.3575761, 0.7151522, 0.1191920,
    0.1804375, 0.0721750, 0.9503041);
const mat3 XYZ_TO_LINEAR_SRGB = mat3(
    3.2404542, -0.9692660, 0.0556434,
    -1.5371385, 1.8760108, -0.2040259,
    -0.4985314, 0.0415560, 1.0572252);
const mat3 XYZ_TO_HPE_LMS = mat3(
    0.38971, -0.22981, 0.0,
    0.68898, 1.18340, 0.0,
    -0.07868, 0.04641, 1.0);
const mat3 HPE_LMS_TO_XYZ = mat3(
    1.9102329169, 0.3709500882, 0.0,
    -1.1121299780, 0.6290542715, 0.0,
    0.2019182498, 0.0, 1.0);
const vec3 D65_WHITE_XYZ = vec3(0.95047, 1.0, 1.08883);

vec3 UpgradeToneMap(vec3 original, vec3 proxy, vec3 model, float colour_strength) {
  float original_luminance = Luminance(original);
  float proxy_luminance = max(Luminance(proxy), 1e-6);
  float model_luminance = max(Luminance(model), 1e-6);

  // Below the proxy's own luminance, the original is already representable and is
  // the target outright. Above it, the proxy clipped highlights the original had;
  // hand that clipped difference back on top of the model's answer.
  float target_luminance = original_luminance <= proxy_luminance
      ? original_luminance
      : model_luminance + (original_luminance - proxy_luminance);

  float ratio = target_luminance / model_luminance;
  vec3 rescaled = model * ratio;

  float original_ratio = target_luminance / max(original_luminance, 1e-6);
  vec3 luminance_only = original * original_ratio;

  if (colour_strength <= 0.0) {
    return luminance_only;
  }

  vec3 model_oklab = OklabFromLinearSrgb(model);
  float model_chroma = length(model_oklab.yz);
  vec2 chroma_dir = model_chroma > 1e-6 ? (model_oklab.yz / model_chroma) : vec2(0.0);

  vec3 rescaled_oklab = OklabFromLinearSrgb(rescaled);
  float rescaled_chroma = length(rescaled_oklab.yz);

  vec3 corrected_oklab = vec3(rescaled_oklab.x, chroma_dir * rescaled_chroma);
  vec3 fully_upgraded = LinearSrgbFromOklab(corrected_oklab);

  return mix(luminance_only, fully_upgraded, clamp(colour_strength, 0.0, 1.0));
}

// The proxy encode's luminance roll-off (`encode.comp`'s knee), to rebuild the frame's own proxy
// at full resolution for the matched residual.
vec3 SoftKneeLuminance(vec3 rgb) {
  float l = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
  if (l > 0.75) {
    float rolled = 0.75 + 0.25 * (1.0 - exp(-(l - 0.75) / 0.25));
    rgb *= rolled / l;
  }
  return rgb;
}

// Moves from `p` toward `t` as far as the unit cube allows, along the same direction (hhkbble's
// cube scaling, via upstream `CubeScaleResidual`): the residual never leaves the 8-bit proxy's
// range, and is shortened rather than clipped per channel, which would shift hue.
vec3 CubeScaleResidual(vec3 p, vec3 t) {
  vec3 d = t - p;
  float alpha = 1.0;
  for (int c = 0; c < 3; ++c) {
    if (d[c] > 1e-6) {
      alpha = min(alpha, (1.0 - p[c]) / d[c]);
    } else if (d[c] < -1e-6) {
      alpha = min(alpha, (0.0 - p[c]) / d[c]);
    }
  }
  return p + clamp(alpha, 0.0, 1.0) * d;
}

vec3 GamutCompressReversible(vec3 rgb) {
  vec3 lms = XYZ_TO_HPE_LMS * (LINEAR_SRGB_TO_XYZ * rgb);
  float y = Luminance(rgb);
  vec3 neutral_lms = XYZ_TO_HPE_LMS * (D65_WHITE_XYZ * y);

  float t_max = 1.0;
  for (int c = 0; c < 3; ++c) {
    if (lms[c] < 0.0) {
      float delta = lms[c] - neutral_lms[c];
      if (delta < 0.0) {
        float t_candidate = neutral_lms[c] / (neutral_lms[c] - lms[c]);
        t_max = min(t_max, max(t_candidate, 0.0));
      }
    }
  }

  if (t_max >= 1.0) {
    return rgb;
  }
  vec3 compressed_lms = neutral_lms + (lms - neutral_lms) * t_max;
  return XYZ_TO_LINEAR_SRGB * (HPE_LMS_TO_XYZ * compressed_lms);
}

void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(u_output);
  if (pixel.x >= size.x || pixel.y >= size.y) {
    return;
  }

  // `rgba8` storage-image loads are raw normalized bytes, no sRGB curve applied by
  // the hardware -- decode to linear light explicitly, same as
  // `composition::apply::compose_pixel`'s own `srgb_decode` calls. `.bgr` swizzles
  // the loaded components back into true RGB order first when the real upload was
  // BGR order (see `params.bgr_order`'s doc comment) -- everything below this point
  // only ever deals in canonical `[r, g, b]`.
  bool bgr = params.bgr_order != 0u;

  // Comparison: decided first, because side by side changes which part of the frame this pixel
  // shows, not only which version of it. Everything below reads at `src`; the result is stored at
  // `pixel`.
  vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
  ivec2 src = pixel;
  bool show_original = false;
  bool on_divider = false;
  bool outside_frame = false;
  bool swap_sides = params.compare_swap != 0u;
  if (params.compare_mode == 1u) {
    show_original = (uv.x < 0.5) != swap_sides;
    // Each half is half as wide as the frame and as tall, so fitting the whole frame keeps its
    // shape with bars above and below (zoom 1); zoom 2 fills the half and crops the sides.
    float zoom = clamp(params.compare_zoom, 1.0, 2.0);
    vec2 half_uv = vec2(uv.x < 0.5 ? uv.x * 2.0 : (uv.x - 0.5) * 2.0, uv.y) - 0.5;
    vec2 cmp = vec2(0.5 + half_uv.x / zoom, 0.5 + half_uv.y * 2.0 / zoom);
    outside_frame = any(lessThan(cmp, vec2(0.0))) || any(greaterThan(cmp, vec2(1.0)));
    src = clamp(ivec2(cmp * vec2(size)), ivec2(0), size - ivec2(1));
    on_divider = abs(uv.x - 0.5) < 1.0 / float(size.x);
  } else if (params.compare_mode == 2u) {
    float split = clamp(params.compare_split, 0.0, 1.0);
    show_original = (uv.x < split) != swap_sides;
    on_divider = abs(uv.x - split) < 1.0 / float(size.x);
  }

  vec3 original = SrgbDecode(bgr ? imageLoad(u_original, src).bgr : imageLoad(u_original, src).rgb);
  vec3 proxy = SrgbDecode(bgr ? imageLoad(u_proxy, src).bgr : imageLoad(u_proxy, src).rgb);
  vec3 model = SrgbDecode(bgr ? imageLoad(u_model_answer, src).bgr : imageLoad(u_model_answer, src).rgb);

  vec3 result;
  if (params.mode == 2u) {
    // Mode 2: the encoded-proxy ratio transfer. Only valid when the capture leg
    // actually ran the encode (`composition::encode_pass`), which is why it is a
    // distinct mode rather than the default -- when the encode is unavailable the
    // proxy is still a bit-identical copy of the frame and modes 0/1 below apply.
    //
    // This is upstream's own structure, and it is the reason upstream needs no
    // motion-suppression mask while this project did. `proxy` and `model` are both in
    // the *encoded* space (the model answered on the proxy it was shown), so their
    // luminance quotient is dimensionless -- the model's relative verdict about how
    // much light belongs at this pixel, and nothing else. Applying that factor to the
    // frame's own current luminance means the base picture is always this frame, with
    // only a broad relighting factor carried over from the round trip. A stale factor
    // dims or brightens slightly; a stale *additive* edit (mode 1) pastes
    // spatially-fixed detail onto content that has moved, which is what needed
    // masking, and masking per pixel per frame is what shimmered.
    //
    // The floor is in both halves, so a bright pair is unaffected while the ratio
    // falls smoothly to one as the pair goes black -- without it "two dark pixels
    // divide into an arbitrarily large number and the ratio is then built from
    // rounding noise, which crawls frame to frame".
    const float kRatioFloor = 1.0 / 512.0;
    float wp = max(params.white_point, 1e-4);

    // The proxy input holds the raw frame unless the model ran small (then it is the encoded small
    // proxy, enlarged). Put the raw frame through the same white divide and knee the encode used,
    // so model / proxy is the model's verdict and not the encode's own roll-off: comparing an
    // encoded answer with the raw frame dimmed every highlight above the knee.
    if (params.model_small == 0u) {
      proxy = clamp(SoftKneeLuminance(proxy / wp), 0.0, 1.0);
    }

    // Transfer modes (only when the model worked below the frame's size; at full size all three
    // are the same, bit for bit). Each rewrites the pair the ratio below is taken from.
    if (params.model_small != 0u && params.transfer != 0u) {
      vec3 edit = model - proxy;
      if (params.transfer == 1u) {
        // Matched residual: the frame's own proxy, rebuilt at full resolution, plus only the
        // model's difference -- so the enlargement's blur is not read as the model's edit.
        vec3 full_proxy = clamp(SoftKneeLuminance(original / wp), 0.0, 1.0);
        proxy = full_proxy;
        model = CubeScaleResidual(full_proxy, full_proxy + edit);
      } else if (Luminance(model) > 1e-5) {
        // Native + edit (xenmods' DLSSNR-Cost-Scaler technique via upstream; no code copied):
        // the frame's own pixels with the edit laid on top, so everything the model had no
        // opinion about keeps its native sharpness. An addition says nothing about where the sum
        // lands, so it is bounded: the neighbourhood's light may move by the highlight guard, and
        // a single pixel may depart from that level by a fixed 1.6x and no more.
        const float kEditFloor = 1.0 / 512.0;
        float m_lum = Luminance(model);
        float p_lum = Luminance(proxy);
        float edit_ratio_n = (m_lum + kEditFloor) / (p_lum + kEditFloor);
        ivec2 last_px = size - ivec2(1);
        float m_acc = m_lum;
        float p_acc = p_lum;
        const ivec2 kNTaps[4] = ivec2[4](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
        for (int k = 0; k < 4; ++k) {
          ivec2 q = clamp(src + kNTaps[k], ivec2(0), last_px);
          m_acc += Luminance(SrgbDecode(bgr ? imageLoad(u_model_answer, q).bgr : imageLoad(u_model_answer, q).rgb));
          p_acc += Luminance(SrgbDecode(bgr ? imageLoad(u_proxy, q).bgr : imageLoad(u_proxy, q).rgb));
        }
        float gain_smooth_n = (m_acc / 5.0 + kEditFloor) / (p_acc / 5.0 + kEditFloor);
        vec3 upgraded = max(original + edit * wp * clamp(params.transfer_strength, 0.0, 1.0), vec3(0.0));
        float o_lum = Luminance(original);
        float sum_lum = Luminance(upgraded);
        if (sum_lum > 1e-5 && p_lum > 1e-5) {
          float guard_n = max(params.max_ratio, 1.0);
          float broad = o_lum * clamp(gain_smooth_n, 1.0 / guard_n, guard_n);
          const float kPixelBand = 1.6;
          float max_l = max(broad * kPixelBand, o_lum * edit_ratio_n * 0.25 + 0.02);
          float min_l = broad / kPixelBand;
          if (sum_lum > max_l) {
            upgraded *= max_l / sum_lum;
          } else if (sum_lum < min_l) {
            upgraded *= min_l / sum_lum;
          }
        }
        // The ratio below is then taken against the frame itself.
        proxy = original;
        model = upgraded;
      }
    }

    float proxy_luminance = Luminance(proxy);
    float model_luminance = Luminance(model);
    float original_luminance = Luminance(original);

    if (model_luminance <= 1e-5) {
      // The model can return an empty frame for an input it could not read; rescaling
      // that collapses the picture to black, so the frame is handed back untouched.
      result = original;
    } else {
      float edit_ratio = (model_luminance + kRatioFloor) / (proxy_luminance + kRatioFloor);

      // Ratio smoothing: the ratio's high-frequency part replaced by the neighbourhood's (five
      // taps). What the model has a real opinion about at this scale is how much light belongs
      // here, not which pixel is brighter than its neighbour -- the frame already knows that and is
      // about to be multiplied by this. Where the ratio is already smooth this is the identity.
      if (params.ratio_smooth > 0.0) {
        ivec2 last_px = size - ivec2(1);
        float m_acc = model_luminance;
        float p_acc = proxy_luminance;
        const ivec2 kTaps[4] = ivec2[4](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
        for (int k = 0; k < 4; ++k) {
          ivec2 q = clamp(src + kTaps[k], ivec2(0), last_px);
          m_acc += Luminance(SrgbDecode(bgr ? imageLoad(u_model_answer, q).bgr : imageLoad(u_model_answer, q).rgb));
          p_acc += Luminance(SrgbDecode(bgr ? imageLoad(u_proxy, q).bgr : imageLoad(u_proxy, q).rgb));
        }
        float gain_smooth = (m_acc / 5.0 + kRatioFloor) / (p_acc / 5.0 + kRatioFloor);
        edit_ratio = mix(edit_ratio, gain_smooth, clamp(params.ratio_smooth, 0.0, 1.0));
      }

      // Ghost guard.
      //
      // The answer is for the frame the model was shown, and this pass runs on a later one --
      // at 4K the model takes tens of milliseconds, so the camera has usually moved. The ratio
      // above is the model's per-pixel verdict *at the old positions*: where it brightened a
      // dark stroke, the ratio is high at the stroke's old position, and multiplying the new
      // frame there lays a pale copy of the old stroke over whatever now occupies the spot
      // (measured on GTA V: doubled sign lettering, offset by the camera's travel).
      //
      // Where the frame has changed since the proxy was made, keep only the broad relighting:
      // take the ratio of the neighbourhood's mean model and proxy luminance instead of the
      // pixel's own. Where it has not changed, the full per-pixel ratio stands, so static
      // detail keeps everything the model added.
      //
      // "Changed" is the worst mismatch between the current frame and the proxy over a 5x5
      // neighbourhood at a stride of 3 pixels -- a stroke three pixels wide always has a tap
      // on it -- read as a fraction of the local light, with a floor so sensor-level noise in
      // dark areas is not motion. The proxy is the frame itself below the encode's knee, so the
      // comparison is only meaningful there; taps over highlights, where the encode
      // legitimately differs, are ignored. The mask is soft, not a hard threshold, so a
      // pixel hovering near it does not flicker between the two ratios.
      if (params.ghost_guard > 0.0) {
        const int kGhostStep = 3;
        ivec2 last = size - ivec2(1);
        float proxy_sum = 0.0;
        float model_sum = 0.0;
        float worst = 0.0;
        for (int j = -2; j <= 2; ++j) {
          for (int i = -2; i <= 2; ++i) {
            ivec2 q = clamp(src + ivec2(i, j) * kGhostStep, ivec2(0), last);
            vec3 pq = SrgbDecode(bgr ? imageLoad(u_proxy, q).bgr : imageLoad(u_proxy, q).rgb);
            vec3 mq = SrgbDecode(bgr ? imageLoad(u_model_answer, q).bgr : imageLoad(u_model_answer, q).rgb);
            vec3 oq = SrgbDecode(bgr ? imageLoad(u_original, q).bgr : imageLoad(u_original, q).rgb);
            float pl = Luminance(pq);
            proxy_sum += pl;
            model_sum += Luminance(mq);
            float valid = 1.0 - smoothstep(0.5, 0.7, pl);
            worst = max(worst, valid * abs(Luminance(oq) - pl) / (0.03 + 0.5 * pl));
          }
        }
        float smooth_ratio = (model_sum / 25.0 + kRatioFloor) / (proxy_sum / 25.0 + kRatioFloor);
        float moved = smoothstep(0.35, 1.2, worst);
        edit_ratio = mix(edit_ratio, smooth_ratio, moved * clamp(params.ghost_guard, 0.0, 1.0));
      }
      // Detail strength above 1 as a power on the ratio, not an extended blend: it
      // cannot go negative, leaves an unchanged pixel alone (one to any power is one),
      // moves brightening and darkening by the same factor, and stays a ratio, so the
      // guard below still binds it.
      float amplified = pow(max(edit_ratio, 1e-6), 1.0 + max(params.transfer_strength - 1.0, 0.0));

      float guard = max(params.max_ratio, 1.0);
      // Relighting cannot invent light, so the room to brighten shrinks toward none as
      // a pixel approaches black -- and below the floor a lift amplifies 8-bit
      // quantisation rather than the model's verdict.
      float lift = mix(1.0, guard, smoothstep(0.0, 8.0 * kRatioFloor, original_luminance));
      // And the room to darken shrinks toward none as a pixel approaches white: a
      // detail pass has no business dimming a light source.
      float drop = mix(1.0 / guard, 1.0, smoothstep(0.6, 1.1, original_luminance));
      float bounded_ratio = clamp(amplified, drop, lift);

      vec3 luminance_only = original * bounded_ratio;
      if (params.colour_strength <= 0.0) {
        result = GamutCompressReversible(luminance_only);
      } else {
        // At colour strength 1 the model's hue arrives as well, carried at the
        // bounded luminance so the guard still decides brightness. Same OkLab
        // construction `UpgradeToneMap` uses: the model's chroma *direction* with the
        // rescaled picture's own chroma magnitude, so a scalar bound cannot be turned
        // into a hue shift.
        vec3 model_oklab = OklabFromLinearSrgb(model);
        float model_chroma = length(model_oklab.yz);
        vec2 chroma_dir = model_chroma > 1e-6 ? (model_oklab.yz / model_chroma) : vec2(0.0);
        vec3 rescaled_oklab = OklabFromLinearSrgb(luminance_only);
        float rescaled_chroma = length(rescaled_oklab.yz);
        vec3 corrected_oklab = vec3(rescaled_oklab.x, chroma_dir * rescaled_chroma);
        vec3 fully_upgraded = LinearSrgbFromOklab(corrected_oklab);
        // The answer crosses as 8-bit, so in a near-black region its hue is decided by which
        // channel happened to round up, and the step above would carry that noise onto the frame
        // at the frame's own brightness: the blue, green and pink specks and patches on dark,
        // detailed content. The model's colour is therefore trusted in proportion to the light it
        // reported, tapering to none below 25/255 (sRGB) -- upstream's `hueTrust`
        // (dlssnr.hlsl, `kQuantFloor`). Above that floor nothing changes.
        const float kQuantFloor = 0.0097; // SrgbDecode(25/255)
        float hue_trust = smoothstep(0.0, kQuantFloor, model_luminance);
        // Colour trust: bound the colour difference rather than switch it off. A correction of
        // ordinary size passes whole; fringing, larger still, is shortened along its own direction,
        // so more disagreement can never mean less colour, only the same amount of it.
        vec3 colour_dev = fully_upgraded - luminance_only;
        float chroma_swing = length(colour_dev) / max(Luminance(luminance_only), 1e-4);
        float colour_allow = params.colour_trust <= 0.0 ? 0.0 : min(1.0, params.colour_trust / max(chroma_swing, 1e-6));
        vec3 bounded_colour = luminance_only + colour_dev * colour_allow;
        result = GamutCompressReversible(mix(luminance_only, bounded_colour, clamp(params.colour_strength, 0.0, 1.0) * hue_trust));
      }
    }
  } else if (params.mode == 1u) {
    // Guarded-additive, for the async held-answer path (`carry_delta`, deleted
    // 2026-09-17 -- see git history -- used to live here as a motion-suppressed
    // reprojection of this same edit; replaced after reading DLSS5VKLayer's own
    // `dlssnr.hlsl` (AGPL-3.0) directly).
    //
    // Upstream's resolve function documents trying exactly that reprojection
    // technique for its *main* path and measuring it a dead end twice ("the model
    // re-decides its detail with the framing, so an old answer does not belong to a
    // new frame and reprojecting it only moves where the disagreement lands"); their
    // fix there is to re-anchor to a ratio-transfer every frame with no motion
    // suppression at all -- mode 0, below, is that formula, and this project already
    // had it (independently, from RenoDX). But mode 0 measurably self-cancels a
    // strong answer on this project's own async path specifically: unlike upstream,
    // this pipeline's `proxy` is a bit-identical copy of `original` at capture time
    // (no separate tone-mapping/encode step in between), so whenever the scene has
    // not moved, mode 0's ratio-rescale target collapses to `original` itself and the
    // model's answer is discarded regardless of how strong it is -- a real, previously
    // measured bug (see capture.rs's doc comment on `proxy == original`), and this
    // shader's own test caught it again live while building this change.
    //
    // The core here is adapted instead from DLSS5VKLayer's *other* mode ("native +
    // edit", `gTransfer == 2`): add the model's own edit onto the current frame
    // directly, rather than rescaling toward the model's answer by a ratio that can
    // vanish. Upstream credits that rule's shape to xenmods/DLSSNR-Cost-Scaler (MIT);
    // no code from either project is copied here, only the strategy (additive,
    // current-anchored, luminance-guarded).
    //
    // What IS added here that upstream's version does not need: a motion-based
    // suppression term. Upstream's round trip evidently keeps `proxy`/`model` close
    // enough behind `original` that an unconditional additive edit does not visibly
    // drag. This project's, even after the 2026-09-17 `working_scale` fix, measures
    // 11-26ms end to end -- at 120fps a multi-frame staleness window, long enough
    // that an unconditional additive edit visibly drags the model's spatially-fixed
    // correction across content that has since moved (the ghosting this project has
    // fought since v0.1.49). So: additive core (fixes the self-cancellation bug,
    // confirmed live), still faded by how far the current pixel has moved from the
    // model's own source frame (fixes the drag) -- a genuine synthesis grounded in
    // measured differences between the two pipelines, not a literal port either way.
    vec3 edit = model - proxy;
    float motion = max(max(abs(original.r - proxy.r), abs(original.g - proxy.g)), abs(original.b - proxy.b));
    float stability = 1.0 - smoothstep(0.01, 0.06, motion);
    vec3 upgraded = original + edit * stability * clamp(params.transfer_strength, 0.0, 1.0);

    // Guard, ported from DLSS5VKLayer's `dlssnr.hlsl` (AGPL-3.0) directly, replacing
    // the symmetric `original_luminance * add_guard` bound this used to carry.
    //
    // The old bound was symmetric and epsilon-gated, which is precisely the failure
    // upstream's own source documents and fixes: "in linear light divided by paper
    // white a shadowed pixel sits around a thousandth, so a tiny absolute edit from
    // the model becomes an enormous ratio, hits the clamp, and doubles that pixel's
    // brightness. The next frame it lands slightly differently and the pixel drops
    // back. That is the boiling: patches of lighter colour crawling over otherwise
    // still geometry, worst where the picture is darkest." A `> 1e-5` test does not
    // prevent that -- it only skips pixels that are *exactly* black, and every
    // near-black pixel above it still gets the full symmetric factor.
    //
    // Three pieces, all upstream's:
    //   * a ratio floor added above *and* below, so the ratio falls smoothly to 1 as
    //     luminance approaches zero instead of exploding ("no edit at all is the
    //     right answer for a pixel with no light in it");
    //   * `lift`, shrinking the room to *brighten* toward none as a pixel approaches
    //     black -- relighting cannot invent light, and below the floor a lift
    //     amplifies 8-bit quantisation rather than the model's verdict;
    //   * `drop`, shrinking the room to *darken* toward none as a pixel approaches
    //     white -- a detail pass has no business dimming a light source.
    // One scalar taken from luminance and applied to the whole triple, never
    // per-channel: a per-channel bound is a hue distorter on saturated pixels.
    const float kRatioFloor = 1.0 / 512.0;
    float original_luminance = Luminance(original);
    float sum_luminance = Luminance(upgraded);
    float guard = max(params.max_ratio, 1.0);
    float lift = mix(1.0, guard, smoothstep(0.0, 8.0 * kRatioFloor, original_luminance));
    float drop = mix(1.0 / guard, 1.0, smoothstep(0.6, 1.1, original_luminance));
    float luma_ratio = (sum_luminance + kRatioFloor) / (original_luminance + kRatioFloor);
    float bounded_ratio = clamp(luma_ratio, drop, lift);
    // Back out the luminance that bounded ratio asks for, then rescale the additive
    // result onto it. Scaling (rather than replacing) keeps the edit's own hue and
    // detail while the brightness movement stays inside the bound.
    float target_luminance = max((original_luminance + kRatioFloor) * bounded_ratio - kRatioFloor, 0.0);
    if (sum_luminance > 1e-6) {
      upgraded *= target_luminance / sum_luminance;
    }
    result = GamutCompressReversible(upgraded);
  } else {
    // Mode 0: the classic ratio-transfer (`UpgradeToneMap`), for the sync/one-shot
    // dispatch path, where `proxy` need not be bit-identical to `original`. See the
    // comment above for why the async held-answer path (mode 1) cannot safely use
    // this one.
    vec3 upgraded = UpgradeToneMap(original, proxy, model, params.colour_strength);
    // The transfer is a ratio against the proxy's own pixel, guarded by max_ratio so a
    // near-black proxy pixel can't produce an unbounded multiply/divide (see
    // neural_forge_protocol::ShmHeader::max_ratio_bits's doc comment).
    vec3 safe_proxy = max(proxy, vec3(1e-4));
    vec3 transfer_ratio = clamp(upgraded / safe_proxy, 1.0 / params.max_ratio, params.max_ratio);
    vec3 transferred = original * transfer_ratio;

    vec3 blended = mix(original, transferred, clamp(params.transfer_strength, 0.0, 1.0));
    result = GamutCompressReversible(blended);
  }

  if (show_original) {
    result = original;
  }
  if (outside_frame) {
    result = vec3(0.0); // the letterbox bars
  }
  if (on_divider) {
    result = vec3(1.0); // a hairline, so the two sides are never mistaken for one picture
  }

  vec3 encoded = SrgbEncode(result);
  // Swizzle back to the real upload order before storing -- `u_output`'s bytes get
  // copied verbatim (no reformatting) into the real swapchain image afterward, so
  // they must already be in that image's true B,G,R,A order when the swapchain is
  // BGR, not canonical R,G,B,A.
  imageStore(u_output, pixel, vec4(bgr ? encoded.bgr : encoded, 1.0));
}
