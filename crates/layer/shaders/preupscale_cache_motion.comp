#version 450
// The pre-upscaler edit cache (docs/ARCHITECTURE.md 4.10), preupscale_cache_motion.comp: The
// accumulated motion (cache_common.py acc_step), in the capture after the prep pass: this hold's
// motion vector from the nearest surface of the 3x3 (NearestSurfaceMotion), plus the previous hold's
// accumulated field read where it leads, NaN where the chain leaves the frame. The network reads the
// field for its history (native_preprocess.comp, binding 2) and the cache for where each pixel was on
// the refresh hold. At interval 1 (flags without F_CHAINED) the vectors are copied as they are. Also
// how far each pixel has travelled since the refresh (u_stale, the guided filter's weight), and on a
// walking refresh where its walk starts (one step back along this hold's vector to what was on screen).
//
// Ported from optiscaler-dlss5 by Skynizz (https://github.com/Skynizz/optiscaler-dlss5), commit
// 6bfc4389c25054ef6747df6e6b1b470e9541c4da: OptiScaler/shaders/dlssnr/precompile/dlssnr_cache.hlsl
// (NearestSurfaceMotion, mode 5). Upstream is GPL-3.0; this port is distributed under this project's
// AGPL-3.0-or-later (see ATTRIBUTION.md).
//
// The numbers are those of scripts/cache_common.py, the numpy reference this shader mirrors step
// for step (each function names its counterpart there); keep the two in step. Pixel units: a pixel
// centre is i + 0.5. Every buffer is at the render extent, row-major.
//
// The descriptor set layout, the push constants and the shared functions below are identical in
// every preupscale_cache_*.comp (no include: scripts/check_shaders.py hashes .comp files only) and
// in `preupscale::cache::CachePush` (field for field, append only).
layout(local_size_x = 8, local_size_y = 8) in;

// Where the buffers live (`preupscale::cache::ScratchLayout`): u_start in the cache's own store (it
// crosses the network's frame on a refresh hold); everything else from binding 6 on in the network's
// input features, which only the network's frame writes and reads (`preprocess` rewrites all of them
// before the graph reads any): the refresh's edit is written after that frame and read until the next
// refresh's, the per-hold buffers live within a hold's capture or write-back. Edits are EDIT16: three
// 16-bit fixed-point stops (+-edit_range()) in a uvec2 whose last half is spare.

// DLSS's colour input, GENERAL (the apply writes it in place; the capture reads it before the decode).
layout(set = 0, binding = 0, rgba16f) uniform image2D u_colour;
// The encoded proxy (padded extent): the decode's clamped-highlight rule.
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D u_encoded;
// The exposure texel (R16_SFLOAT in the low 16 bits).
layout(set = 0, binding = 2, std430) readonly buffer Exposure { uint bits; } u_exposure;
// DLSS's depth as the capture copied it (`native::DepthCopy`): raw texels, p.depth_kind says how.
layout(set = 0, binding = 3, std430) readonly buffer Depth { uint raw[]; } u_depth;
// DLSS's motion vectors as the capture copied them: one packed half2 per texel.
layout(set = 0, binding = 4, std430) readonly buffer Motion { uint mv[]; } u_motion;
// The accumulated motion (the network's binding 2), in the motion vectors' own units (times
// p.mvec_scale = render pixels), and its copy from the previous hold.
layout(set = 0, binding = 5, std430) buffer Acc { vec2 v[]; } u_acc;
layout(set = 0, binding = 6, std430) buffer AccPrev { vec2 v[]; } u_acc_prev;
// This hold's pseudo-linear depth (the prep pass; a refresh's write-back reads the depth again, the
// network's frame having overwritten this).
layout(set = 0, binding = 7, std430) buffer Lin { float v[]; } u_lin;
// The pseudo-linear depth of the hold u_shown's edit was shown on.
layout(set = 0, binding = 8, std430) buffer ShownLin { float v[]; } u_shown_lin;
// The refresh hold: its clamped edit (EDIT16), its fingerprint (three floats a texel: log luma, log
// r/g, log b/g) and its depth (binding 18).
layout(set = 0, binding = 9, std430) buffer SrcEdit { uvec2 v[]; } u_src_edit;
layout(set = 0, binding = 10, std430) buffer SrcPrint { float v[]; } u_src_print;
// A cached hold: the history read (EDIT16, the weight valid x validity as UNORM16 in the spare
// half) and its confidence. A refresh hold: the capture's walked picture for the refresh pass
// (packed half4, alpha 1 where it walks).
layout(set = 0, binding = 11, std430) buffer Hist { uvec2 v[]; } u_hist;
layout(set = 0, binding = 12, std430) buffer Conf { float v[]; } u_conf;
// The pyramid, levels 0..2 one after the other, two vec4 a texel: (edit rgb, coverage), (log2
// depth, log luma, 0, 0).
layout(set = 0, binding = 13, std430) buffer Levels { vec4 v[]; } u_levels;
// Host-visible counters (STAT_*), cleared by the CPU before the hold.
layout(set = 0, binding = 14, std430) buffer Stats { uint v[]; } u_stats;
// The network's answer image (padded extent, proxy domain): the refresh capture's decode.
layout(set = 0, binding = 15, rgba16f) uniform readonly image2D u_answer;
// The refresh hold's walk start (EDIT16): what was on screen, where the shown edit walks from to the
// answer across the interval (the answer itself where nothing walks). A walking refresh's motion pass
// leaves the start it found there for the capture, the spare half 1 where it walks.
layout(set = 0, binding = 16, std430) buffer Start { uvec2 v[]; } u_start;
// The edit each hold showed (EDIT16; with the debug mask, the apply's spare half carries the weight
// and the confidence, 8 bits each): the next refresh's walk start.
layout(set = 0, binding = 17, std430) buffer Shown { uvec2 v[]; } u_shown;
layout(set = 0, binding = 18, std430) buffer SrcLin { float v[]; } u_src_lin;
// The guided filter's half-size grids, two vec4 a texel each: the 2x2 means, then the tent-blurred
// coefficients (a); its coefficients (b). Over the history read and the pyramid, done with by then.
layout(set = 0, binding = 19, std430) buffer GuideA { vec4 v[]; } u_guide_a;
layout(set = 0, binding = 20, std430) buffer GuideB { vec4 v[]; } u_guide_b;
// How far each pixel has moved since the refresh (one per 4 px of each hold's motion, at most one a
// hold), and its copy from the previous hold.
layout(set = 0, binding = 21, std430) buffer Stale { float v[]; } u_stale;
layout(set = 0, binding = 22, std430) buffer StalePrev { float v[]; } u_stale_prev;

layout(push_constant) uniform Params {
  uvec2 size;            // render extent
  uint flags;            // F_*
  uint depth_kind;       // 0 none, 1 f32 bits (D32, R32), 2 D24 UNORM (low 24 bits), 3 D16 UNORM
  vec2 mvec_scale;       // motion-vector units -> render pixels
  vec2 step_jitter;      // jitter[t-1] - jitter[t]
  vec2 refresh_jitter;   // jitter[refresh] - jitter[t]
  float paper_white;
  uint level;            // the reduce pass: the level it builds
  float eps_v;
  float max_luma_edit;
  float chroma_stops;
  float depth_tol;
  float colour_tol;
  float colour_floor;
  float print_tol;
  float sigma_depth;
  float sigma_luma;
  float walk;            // how far the shown edit has walked from u_start to the answer
  float guided_eps;      // the guided filter's regularisation
} p;

const uint F_REVERSE_Z = 1u;     // depth: near is larger (reversed-Z)
const uint F_NEAREST = 2u;       // motion from the nearest surface of the 3x3 (only with depth)
const uint F_FRESH = 4u;         // the previous hold refreshed: its accumulated field is zero
const uint F_CHAINED = 8u;       // accumulate (else the motion pass copies the vectors as they are)
const uint F_WALK = 16u;         // a refresh walks from the last shown edit (it was the hold before)
const uint F_DEBUG_MASK = 32u;   // the apply writes the rejection mask instead of the frame
const uint F_KEEP_CLAMPED = 64u; // the decode's rule: keep the original where the encode clamped
const uint F_SCENE_ANSWER = 128u; // (tests) the capture's answer image holds the decoded answer
const uint F_COUNT_DEPTH = 256u; // the prep pass counts the depth for telling reversed-Z (until decided)

const uint STAT_Z0 = 0u;         // depth texels at exactly 0 / 1
const uint STAT_Z1 = 1u;
const uint STAT_DEPTH_N = 2u;
const uint STAT_TOP_SUM = 3u;    // depth x 2048 summed over the top / bottom quarter rows
const uint STAT_TOP_N = 4u;
const uint STAT_BOTTOM_SUM = 5u;
const uint STAT_BOTTOM_N = 6u;
const uint STAT_REJECTED = 7u;   // cached hold: texels whose history was rejected (weight < 0.5)
const uint STAT_EDIT_OK = 8u;    // refresh capture: 1 = an edit was stored (usable exposure)
const uint STAT_APPLY_BAD = 9u;  // cached hold: 1 = unusable exposure, nothing was written

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
const float KNEE = 0.75;
const float K = 5.770780;
const float CLAMPED = 0.999;

uint index_of(uvec2 xy) { return xy.y * p.size.x + xy.x; }

// The guided filter's half-size grid (guided_fast's half: rounded up).
uvec2 half_size() { return (p.size + 1u) / 2u; }

bool exposure_ok(float e) { return e > 1e-6 && e < 65504.0; }

float exposure() { return unpackHalf2x16(u_exposure.bits).x; }

float nan_value() { return uintBitsToFloat(0x7fc00000u); }

// to_v: v = max(scene, 0) * e / W; NaN and infinities count as 0.
vec3 to_v(vec3 scene, float scale) {
  vec3 s = mix(scene, vec3(0.0), bvec3(isnan(scene.x) || isinf(scene.x), isnan(scene.y) || isinf(scene.y), isnan(scene.z) || isinf(scene.z)));
  return max(s, vec3(0.0)) * scale;
}

// clamp_edit (ClampEdit): the luma within +-max_luma_edit, each channel within chroma_stops of it.
vec3 clamp_edit(vec3 e) {
  if (!(p.max_luma_edit > 0.0)) return e;
  float limit = p.max_luma_edit;
  float l = dot(e, LUMA);
  float lc = clamp(l, -limit, limit);
  e = e + (lc - l);
  return clamp(e, vec3(lc - p.chroma_stops), vec3(lc + p.chroma_stops));
}

// EDIT16: every stored edit is a clamped one (or a mix of clamped ones), within +-edit_range(), in
// steps of 2 edit_range() / 65535 (7.6e-5 stop: within 3.9e-5 of the f32 the tool keeps).
float edit_range() { return p.max_luma_edit > 0.0 ? p.max_luma_edit + p.chroma_stops : 16.0; }

uint fixed16(float e, float r) { return uint(round((clamp(e, -r, r) + r) / (2.0 * r) * 65535.0)); }

float unfixed16(uint q, float r) { return float(q) / 65535.0 * (2.0 * r) - r; }

uvec2 pack_edit(vec3 e, uint spare) {
  float r = edit_range();
  return uvec2(fixed16(e.r, r) | (fixed16(e.g, r) << 16u), fixed16(e.b, r) | (spare << 16u));
}

vec3 unpack_edit(uvec2 w) {
  float r = edit_range();
  return vec3(unfixed16(w.x & 0xffffu, r), unfixed16(w.x >> 16u, r), unfixed16(w.y & 0xffffu, r));
}

uint spare_of(uvec2 w) { return w.y >> 16u; }

uint unorm16(float v) { return uint(round(clamp(v, 0.0, 1.0) * 65535.0)); }

float soft(float d, float tol) { return clamp((2.0 * tol - d) / max(tol, 1e-4), 0.0, 1.0); }

float outside(float v, float lo, float hi) { return max(max(lo - v, v - hi), 0.0); }

// level_size: a quarter each side, rounded up, level + 1 times.
uvec2 level_size(uint level) {
  uvec2 s = p.size;
  for (uint k = 0u; k <= level; k++) s = (s + 3u) / 4u;
  return s;
}

// The first texel (in vec4 pairs' units: 2 per texel) of a level in u_levels.
uint level_base(uint level) {
  uint base = 0u;
  for (uint k = 0u; k < level; k++) {
    uvec2 s = level_size(k);
    base += 2u * s.x * s.y;
  }
  return base;
}

// One texel of DLSS's depth as f32 device depth (cache_dump::depth_to_f32's rule).
float device_depth(uint i) {
  if (p.depth_kind == 3u) {
    uint word = u_depth.raw[i >> 1u];
    return float((i & 1u) == 0u ? word & 0xffffu : word >> 16u) / 65535.0;
  }
  uint raw = u_depth.raw[i];
  return p.depth_kind == 2u ? float(raw & 0x00ffffffu) / 16777215.0 : uintBitsToFloat(raw);
}

// lin_depth (LinDepth): proportional to view depth; 1 everywhere without depth.
float lin_depth(uint i) {
  if (p.depth_kind == 0u) return 1.0;
  float d = device_depth(i);
  d = isnan(d) ? 0.0 : (isinf(d) ? (d > 0.0 ? 1.0 : 0.0) : d);
  return 1.0 / max((p.flags & F_REVERSE_Z) != 0u ? d : 1.0 - d, 1e-7);
}

// print_of (PrintOf): this hold's fingerprint at a texel, log luma and the two log chroma ratios, all
// with eps_v, of the colour input as the game left it (read before the decode or the apply writes it;
// recomputed where needed rather than kept).
vec3 print_at(ivec2 at) {
  float e = exposure();
  vec3 v = to_v(imageLoad(u_colour, at).rgb, exposure_ok(e) ? e / p.paper_white : 0.0);
  vec3 q = max(v, vec3(0.0)) + p.eps_v;
  return vec3(log2(dot(max(v, vec3(0.0)), LUMA) + p.eps_v), log2(q.r / q.g), log2(q.b / q.g));
}

vec2 finite_or_zero(vec2 v) {
  return vec2(isnan(v.x) || isinf(v.x) ? 0.0 : v.x, isnan(v.y) || isinf(v.y) ? 0.0 : v.y);
}

// sample_bilinear_taken: the previous accumulated field (render pixels) at pos; taps of weight 0
// skipped, a NaN in one that counts gives NaN.
vec2 previous_acc(vec2 pos) {
  vec2 px = pos - 0.5;
  vec2 f0 = floor(px);
  vec2 f = px - f0;
  ivec2 i0 = ivec2(f0);
  vec2 r = vec2(0.0);
  for (int k = 0; k < 4; k++) {
    int ox = k & 1;
    int oy = k >> 1;
    float w = (ox == 1 ? f.x : 1.0 - f.x) * (oy == 1 ? f.y : 1.0 - f.y);
    if (w > 0.0) {
      ivec2 t = clamp(i0 + ivec2(ox, oy), ivec2(0), ivec2(p.size) - 1);
      r += u_acc_prev.v[uint(t.y) * p.size.x + uint(t.x)] * p.mvec_scale * w;
    }
  }
  return r;
}

// sample_bilinear of the previous hold's staleness at pos (edge-clamped).
float previous_stale(vec2 pos) {
  vec2 px = pos - 0.5;
  vec2 f0 = floor(px);
  vec2 f = px - f0;
  ivec2 i0 = ivec2(f0);
  float r = 0.0;
  for (int k = 0; k < 4; k++) {
    int ox = k & 1;
    int oy = k >> 1;
    ivec2 t = clamp(i0 + ivec2(ox, oy), ivec2(0), ivec2(p.size) - 1);
    r += u_stale_prev.v[uint(t.y) * p.size.x + uint(t.x)] * (ox == 1 ? f.x : 1.0 - f.x) * (oy == 1 ? f.y : 1.0 - f.y);
  }
  return r;
}

// A walking refresh's start (run_cadence's crossfade and soft refresh), found here because the edit
// it walks from is gone once the network has run: the last shown edit one step back (step_position,
// read_admitted: four taps admitted by depth against the hold it was shown on), or, where that is no
// surface of this hold, read plainly when something came in front of a still view. Where neither
// (the background a move revealed) nothing walks (spare 0): the capture takes the answer at once.
uvec2 walk_start(uvec2 xy, uint i, vec2 mv) {
  float lin_c = u_lin.v[i];
  vec2 pos = vec2(xy) + 0.5 + mv + p.step_jitter;
  vec2 px = pos - 0.5;
  vec2 f0 = floor(px);
  vec2 f = px - f0;
  ivec2 i0 = ivec2(f0);
  vec3 then = vec3(0.0);
  vec3 plain = vec3(0.0);
  float lin_then = 0.0;
  float wsum = 0.0;
  float tol = p.depth_tol;
  for (int k = 0; k < 4; k++) {
    int ox = k & 1;
    int oy = k >> 1;
    ivec2 t = clamp(i0 + ivec2(ox, oy), ivec2(0), ivec2(p.size) - 1);
    uint j = uint(t.y) * p.size.x + uint(t.x);
    vec3 s = unpack_edit(u_shown.v[j]);
    float s_lin = u_shown_lin.v[j];
    float wb = (ox == 1 ? f.x : 1.0 - f.x) * (oy == 1 ? f.y : 1.0 - f.y);
    float rel = abs(s_lin - lin_c) / max(min(s_lin, lin_c), 1e-7);
    float wt = wb * clamp((2.0 * tol - rel) / max(tol, 1e-6), 0.0, 1.0);
    then += s * wt;
    wsum += wt;
    plain += s * wb;
    lin_then += s_lin * wb;
  }
  then /= wsum > 1e-4 ? wsum : 1.0;
  bool on_surface = clamp(wsum, 0.0, 1.0) > 0.5;
  bool front = length(mv + p.step_jitter) < 1.0 && lin_c <= lin_then * (1.0 + tol);
  if (!(on_surface || front)) return uvec2(0u);
  return pack_edit(on_surface ? then : plain, 1u);
}

void main() {
  uvec2 xy = gl_GlobalInvocationID.xy;
  if (any(greaterThanEqual(xy, p.size))) return;
  uint i = index_of(xy);
  // At interval 1 the network reads the vectors as they are, as f32: unpackHalf2x16 is exact, and
  // native_preprocess.comp multiplies by the same scale it always did.
  if ((p.flags & F_CHAINED) == 0u) {
    u_acc.v[i] = unpackHalf2x16(u_motion.mv[i]);
    return;
  }
  // nearest_surface_motion: the vector of the nearest depth in the 3x3 (first in scan order on a tie).
  uint pick = i;
  if ((p.flags & F_NEAREST) != 0u) {
    float best = 1e38;
    bool first = true;
    for (int dy = -1; dy <= 1; dy++) {
      for (int dx = -1; dx <= 1; dx++) {
        ivec2 t = clamp(ivec2(xy) + ivec2(dx, dy), ivec2(0), ivec2(p.size) - 1);
        uint j = uint(t.y) * p.size.x + uint(t.x);
        float l = u_lin.v[j];
        if (first || l < best) {
          best = l;
          pick = j;
          first = false;
        }
      }
    }
  }
  vec2 mv = finite_or_zero(unpackHalf2x16(u_motion.mv[pick]) * p.mvec_scale);
  if ((p.flags & F_WALK) != 0u) u_start.v[i] = walk_start(xy, i, mv);
  // acc_step: acc_t(x) = mv_t(x) + acc_{t-1}(x + mv_t(x) + jitter[t-1] - jitter[t]).
  vec2 at = vec2(xy) + 0.5 + mv + p.step_jitter;
  vec2 acc = mv;
  // run_cadence's staleness: one per 4 px of this hold's motion (at most one), plus the previous
  // hold's read bilinearly where the motion leads (none right after a refresh).
  float stale = clamp(length(mv + p.step_jitter) / 4.0, 0.0, 1.0);
  if ((p.flags & F_FRESH) == 0u) {
    acc += previous_acc(at);
    stale += previous_stale(at);
  }
  u_stale.v[i] = stale;
  bool on = at.x >= 0.0 && at.x <= float(p.size.x) && at.y >= 0.0 && at.y <= float(p.size.y);
  u_acc.v[i] = on ? acc / p.mvec_scale : vec2(nan_value());
}
