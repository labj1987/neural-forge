#version 450
// The native backend after the upscaler (docs/NATIVE_BACKEND.md, "2.1"): the network's head on the 8-bit
// proxy, in the proxy's own format, for the unchanged after-the-upscaler composition to use. The residual,
// the half-grid truncation, the style operator and the intensity blend are native_composite.comp's
// (OpenDLSS-NR's, MIT, commit 9d08f41). With a history (docs/NATIVE_BACKEND.md, "History after the
// upscaler"; p.frame.z set) the blend toward the reprojected previous output by sigmoid(logit) x blend scale
// is native_composite.comp's too, where native_post_preprocess.comp kept it; the result, before the style
// and intensity, is this pass's next history (p.frame.w set). Without one (NEURAL_FORGE_POST_MOTION=none,
// the shipped behaviour) nothing blends. The answer is 8 bits in the proxy's own channel order, rounded to
// nearest (as an RGBA8 image store rounds), alpha copied.
//
// The colour of the edit (docs/NATIVE_BACKEND.md, "The colour of the edit"; native_colour.comp's steps on the
// 8-bit proxy's own values): with p.colour_flags.x bit 1 the change e = published - proxy is reshaped
// (detail against its 3x3 binomial low-pass, from the neighbours' answers worked out here, once per group;
// saturation and contrast around its BT.709 luma; the look-up table on the last pass, scaled by the edit's size; the gamut
// guard shortening it along itself to stay in 0-1). Bit 16 dithers the quantisation: an 8x8 ordered
// offset in (-0.5, 0.5) of the 8-bit step, so a level is the neighbour above or below it, never further.
// The history is stored before any of this: it stays the network's answer. With no bit set the answer is
// computed exactly as before.
//
// The HUD (docs/NATIVE_BACKEND.md, "The HUD at present"; p.hud.x set on the last pass): where
// native_post_hud.comp's scale is below 1, the answer is moved back toward the frame's own proxy by it (0: the
// frame's texel exactly), after every step above, so the whole stack's edit is what is scaled. Where it is 1
// nothing changes.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, std430) readonly buffer Proxy { uint texel[]; } u_proxy;
// f32 [field][4]: RGB residual, blend logit.
layout(set = 0, binding = 1, std430) readonly buffer Head { float head[]; } u_head;
layout(set = 0, binding = 2, std430) writeonly buffer Answer { uint texel[]; } u_answer;
// This pass's history (RGB, valid extent: packHalf2x16(r, g), packHalf2x16(b, 1)), written for the next frame.
layout(set = 0, binding = 3, std430) writeonly buffer History { uvec2 texel[]; } u_history;
// native_post_preprocess.comp's reprojected history: as History, the second half of .y 1 where it is kept.
layout(set = 0, binding = 4, std430) readonly buffer Reproj { uvec2 texel[]; } u_reproj;
// The frame's proxy (the first pass's input; read only with p.hud.x).
layout(set = 0, binding = 5, std430) readonly buffer Frame { uint texel[]; } u_frame;
// The look-up table: size^3 RGB entries, red fastest (read only with bit 4).
layout(set = 0, binding = 8, std430) readonly buffer Lut { vec4 entry[]; } u_lut;
// The HUD's scale of the edit per pixel (native_post_hud.comp; read only with p.hud.x).
layout(set = 0, binding = 9, std430) readonly buffer Hud { float s[]; } u_hud;

layout(push_constant) uniform Params {
  uvec4 dims;      // field width, field height, valid width, valid height
  uvec4 frame;     // unused, BGRA (1) or RGBA (0), blend toward the history (1), write the history (1)
  vec4 control;    // style, local tone, intensity, blend scale
  vec4 colour;     // the edit's saturation, contrast, detail, unused
  uvec4 colour_flags; // 1 a step runs, 2 gamut guard, 4 look-up table, 8 detail, 16 dither; table size; unused x2
  vec4 lut_scale;  // per channel (size - 1) / (domain max - min); strength
  vec4 lut_offset; // per channel -domain min x scale; adapt
  vec4 hud;        // apply the HUD's scale (1, the last pass), unused x3
} p;

const uint STEP = 1u;
const uint GUARD = 2u;
const uint LUT = 4u;
const uint DETAIL = 8u;
const uint DITHER = 16u;
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

float truncateHalf(float value) {
  uint bits = floatBitsToUint(value);
  uint signBit = (bits >> 16u) & 0x8000u;
  uint exponent = (bits >> 23u) & 0xffu;
  uint mantissa = bits & 0x7fffffu;
  uint halfBits;
  if (exponent == 0xffu) {
    halfBits = signBit | (mantissa != 0u ? 0x7e00u : 0x7c00u);
  } else {
    int halfExponent = int(exponent) - 112;
    if (halfExponent >= 31) halfBits = signBit | 0x7c00u;
    else if (halfExponent <= 0) {
      if (halfExponent < -10) halfBits = signBit;
      else halfBits = signBit | ((mantissa | 0x800000u) >> uint(14 - halfExponent));
    } else halfBits = signBit | (uint(halfExponent) << 10u) | (mantissa >> 13u);
  }
  return unpackHalf2x16(halfBits).x;
}

// ---- cg2r styles (Natural / Cinematic): native_composite.comp's, OpenDLSS-NR's nrStyle.
vec3 nrHsl(vec3 rgb) {
  float high = max(max(rgb.r, rgb.g), rgb.b);
  float low = min(min(rgb.r, rgb.g), rgb.b);
  float sum = high + low;
  float light = sum * 0.5;
  float hue = 0.0, saturation = 0.0;
  if (high > low) {
    float delta = high - low;
    saturation = light > 0.5 ? delta / ((2.0 - high) - low) : delta / sum;
    if (high == rgb.r) hue = fma(rgb.g - rgb.b, 1.0 / delta, rgb.g < rgb.b ? 6.0 : 0.0) / 6.0;
    else if (high == rgb.g) hue = fma(rgb.b - rgb.r, 1.0 / delta, 2.0) / 6.0;
    else hue = fma(rgb.r - rgb.g, 1.0 / delta, 4.0) / 6.0;
  }
  return vec3(hue, saturation, light);
}

float nrHue(float p, float q, float hue) {
  float h = hue;
  if (h < 0.0) h += 1.0;
  if (h > 1.0) h -= 1.0;
  if (h < uintBitsToFloat(0x3e2aaaabu)) return fma(h, (q - p) * 6.0, p);
  if (h < 0.5) return q;
  if (h < uintBitsToFloat(0x3f2aaaabu)) return fma((uintBitsToFloat(0x3f2aaaabu) - h) * (q - p), 6.0, p);
  return p;
}

vec3 nrRgb(vec3 hsl) {
  if (hsl.y <= 0.0) return vec3(hsl.z);
  float q = hsl.z < 0.5 ? hsl.z * (hsl.y + 1.0) : fma(-hsl.z, hsl.y, hsl.z + hsl.y);
  float p = (hsl.z + hsl.z) - q;
  return vec3(nrHue(p, q, hsl.x + uintBitsToFloat(0x3eaaaaabu)), nrHue(p, q, hsl.x), nrHue(p, q, hsl.x - uintBitsToFloat(0x3eaaaaabu)));
}

vec3 nrStyle(vec3 neural, float style, float tone) {
  float styleTone = clamp(tone, 0.0, 1.0);
  float exposure = style == 1.0 ? -0.1 * styleTone : 0.0;
  float contrast = style == 1.0 ? -0.25 * styleTone : 0.0;
  float saturation = style == 1.0 ? -0.1 * styleTone : -0.15 * styleTone;
  vec3 color;
  for (int c = 0; c < 3; c++) {
    float value = clamp(neural[c], 0.0, 1.0);
    float exposed = clamp(value * exp2(exposure), 0.0, 1.0);
    float square = exposed * exposed;
    float curveDelta = fma(square, 3.0 - (exposed + exposed), -exposed);
    float curved = clamp(fma(contrast, curveDelta, exposed), 0.0, 1.0);
    float firstGamma = exp2(log2(curved));
    color[c] = exp2(log2(max(0.0, firstGamma)));
  }
  vec3 hsl = nrHsl(color);
  vec3 adjusted = nrRgb(vec3(hsl.x, clamp(hsl.y * (saturation + 1.0), 0.0, 1.0), hsl.z));
  vec3 again = nrHsl(adjusted);
  return clamp(nrRgb(vec3(again.x, clamp(exp2(log2(again.y)), 0.0, 1.0), again.z)), vec3(0.0), vec3(1.0));
}

// clamp() of a NaN is undefined (FClamp): a NaN the network's head gives reads as 0, so it never reaches
// the history (and through it the next frame's input lanes) or the 8-bit answer's pack.
float saturateOrZero(float x) {
  return isnan(x) ? 0.0 : clamp(x, 0.0, 1.0);
}

vec3 saturateOrZero(vec3 x) {
  return vec3(saturateOrZero(x.r), saturateOrZero(x.g), saturateOrZero(x.b));
}

// The network's answer at `xy` with the history blend, truncated to the half grid (this pass's next
// history), and the proxy there.
vec3 historyAt(uvec2 xy, out vec3 proxy) {
  uint at = xy.y * p.dims.z + xy.x;
  vec4 texel = unpackUnorm4x8(u_proxy.texel[at]);
  proxy = p.frame.y != 0u ? texel.bgr : texel.rgb;
  uint feature = (xy.y * p.dims.x + xy.x) * 4u;
  vec3 h = vec3(u_head.head[feature], u_head.head[feature + 1u], u_head.head[feature + 2u]);
  vec3 neural = saturateOrZero(fma(h, vec3(0.03125), fma(proxy, vec3(0.125), vec3(-0.0625))) * 8.0 + 0.5);
  if (p.frame.z != 0u) {
    uvec2 r = u_reproj.texel[at];
    vec2 last = unpackHalf2x16(r.y);
    if (last.y > 0.0) {
      float scale = clamp(p.control.w, 0.0, 1.0);
      float weight = saturateOrZero((1.0 / (1.0 + exp2(u_head.head[feature + 3u] * uintBitsToFloat(0xbfb8aa3bu)))) * scale);
      vec3 hist = vec3(unpackHalf2x16(r.x), last.x);
      neural = fma(vec3(weight), hist - neural, neural);
    }
  }
  return vec3(truncateHalf(neural.r), truncateHalf(neural.g), truncateHalf(neural.b));
}

// The style operator on the history, then the intensity blend toward it from the proxy: the answer before
// quantisation.
vec3 publish(vec3 history, vec3 proxy) {
  float style = p.control.x;
  float intensity = p.control.z;
  vec3 styled = style != 0.0 ? nrStyle(history, style, p.control.y) : history;
  vec3 published = history;
  if (style != 0.0 || intensity != 1.0) {
    for (int c = 0; c < 3; c++) published[c] = truncateHalf(clamp(fma(intensity, styled[c] - proxy[c], proxy[c]), 0.0, 1.0));
  }
  return published;
}

// The detail step's neighbours: the change (answer - proxy) of every pixel of this group's 8x8 tile and
// the ring of one around it (the frame's edge repeated), worked out once per group instead of nine times
// per pixel. The same arithmetic as the pixel's own, so the low-pass is what it was per pixel, bit for bit.
const uint TILE = 10u;
shared vec3 s_change[TILE * TILE];

void loadTile() {
  ivec2 origin = ivec2(gl_WorkGroupID.xy * 8u) - 1;
  for (uint k = gl_LocalInvocationIndex; k < TILE * TILE; k += 64u) {
    uvec2 q = uvec2(clamp(origin + ivec2(int(k % TILE), int(k / TILE)), ivec2(0), ivec2(p.dims.zw) - 1));
    vec3 qp;
    vec3 qa = publish(historyAt(q, qp), qp);
    s_change[k] = qa - qp;
  }
  barrier();
}

vec3 lutEntry(uint r, uint g, uint b) {
  uint n = p.colour_flags.y;
  return u_lut.entry[r + n * (g + n * b)].rgb;
}

// Trilinear, as `neural_forge_protocol::cube::Cube::sample`.
vec3 lutSample(vec3 rgb) {
  float last = float(p.colour_flags.y - 1u);
  vec3 t = clamp(rgb * p.lut_scale.xyz + p.lut_offset.xyz, vec3(0.0), vec3(last));
  uvec3 b = uvec3(min(floor(t), vec3(last - 1.0)));
  vec3 f = t - vec3(b);
  vec3 c00 = mix(lutEntry(b.x, b.y, b.z), lutEntry(b.x + 1u, b.y, b.z), f.x);
  vec3 c10 = mix(lutEntry(b.x, b.y + 1u, b.z), lutEntry(b.x + 1u, b.y + 1u, b.z), f.x);
  vec3 c01 = mix(lutEntry(b.x, b.y, b.z + 1u), lutEntry(b.x + 1u, b.y, b.z + 1u), f.x);
  vec3 c11 = mix(lutEntry(b.x, b.y + 1u, b.z + 1u), lutEntry(b.x + 1u, b.y + 1u, b.z + 1u), f.x);
  return mix(mix(c00, c10, f.y), mix(c01, c11, f.y), f.z);
}

// The 8x8 Bayer matrix's value at `xy`, as an offset in (-0.5, 0.5).
float bayer(uvec2 xy) {
  uint x = xy.x & 7u;
  uint y = xy.y & 7u;
  uint v = 0u;
  uint xc = x ^ y;
  // Interleave the bits of x ^ y and y, the coordinates' lowest bits into the value's highest: the
  // recursive Bayer construction (2x2: 0 2 / 3 1).
  for (int bit = 0; bit < 3; bit++) {
    v = (v << 2u) | (((xc >> uint(bit)) & 1u) << 1u) | ((y >> uint(bit)) & 1u);
  }
  return (float(v) + 0.5) / 64.0 - 0.5;
}

// The colour steps on one pixel (native_colour.comp's, on the 8-bit proxy's values).
vec3 colourOf(vec3 proxy, vec3 published) {
  uint flags = p.colour_flags.x;
  vec3 e = published - proxy;
  vec3 r = published;
  bool changed = false;
  if ((flags & DETAIL) != 0u) {
    vec3 low = vec3(0.0);
    ivec2 local = ivec2(gl_LocalInvocationID.xy) + 1;
    for (int dy = -1; dy <= 1; dy++) {
      for (int dx = -1; dx <= 1; dx++) {
        low += float((2 - abs(dx)) * (2 - abs(dy))) * s_change[uint(local.y + dy) * TILE + uint(local.x + dx)];
      }
    }
    low *= 1.0 / 16.0;
    e = low + p.colour.z * (e - low);
    changed = true;
  }
  if (p.colour.x != 1.0 || p.colour.y != 1.0) {
    float l = dot(e, LUMA);
    e = p.colour.y * vec3(l) + p.colour.x * (e - vec3(l));
    changed = true;
  }
  if (changed) r = proxy + e;
  if ((flags & LUT) != 0u) {
    vec3 d = abs(r - proxy);
    float w = p.lut_scale.w * min(1.0, max(d.r, max(d.g, d.b)) / p.lut_offset.w);
    if (w > 0.0) r = mix(r, lutSample(clamp(r, vec3(0.0), vec3(1.0))), w);
  }
  if ((flags & GUARD) != 0u) {
    vec3 d = r - proxy;
    float t = 1.0;
    for (int c = 0; c < 3; c++) {
      if (r[c] > 1.0) t = min(t, (1.0 - proxy[c]) / d[c]);
      else if (r[c] < 0.0) t = min(t, -proxy[c] / d[c]);
    }
    if (t < 1.0) r = proxy + max(t, 0.0) * d;
  }
  return clamp(r, vec3(0.0), vec3(1.0));
}

void main() {
  uvec2 id = gl_GlobalInvocationID.xy;
  uint flags = p.colour_flags.x;
  // The tile before any invocation returns: barrier() needs the whole group (the flags are uniform).
  if ((flags & STEP) != 0u && (flags & DETAIL) != 0u) loadTile();
  if (id.x >= p.dims.z || id.y >= p.dims.w) return;
  uint at = id.y * p.dims.z + id.x;
  vec4 texel = unpackUnorm4x8(u_proxy.texel[at]);
  bool bgra = p.frame.y != 0u;
  vec3 proxy;
  vec3 history = historyAt(id, proxy);
  if (p.frame.w != 0u) u_history.texel[at] = uvec2(packHalf2x16(history.rg), packHalf2x16(vec2(history.b, 1.0)));
  vec3 published = publish(history, proxy);
  if ((flags & STEP) != 0u) published = colourOf(proxy, published);
  if ((flags & DITHER) != 0u) published = published + vec3(bayer(id) / 255.0);
  if (p.hud.x != 0.0) {
    float s = u_hud.s[at];
    if (s < 1.0) {
      vec4 f = unpackUnorm4x8(u_frame.texel[at]);
      vec3 frame = bgra ? f.bgr : f.rgb;
      published = frame + s * (published - frame);
    }
  }
  vec3 out3 = bgra ? published.bgr : published;
  u_answer.texel[at] = packUnorm4x8(vec4(out3, texel.a));
}
