#version 450
// The native backend after the upscaler (docs/NATIVE_BACKEND.md, "2.1"): the network's 16 input lanes from
// the layer's 8-bit swapchain proxy (sRGB code values, display-referred).
// The lane layout, roundings and noise are OpenDLSS-NR's (MIT, commit 9d08f41), as in
// native_preprocess.comp. There are no motion vectors after the upscaler. Without a history (mode 0:
// NEURAL_FORGE_POST_MOTION=none, the shipped behaviour, and every reset frame) lanes 7-9 copy the proxy, as on
// a first frame. With one (docs/NATIVE_BACKEND.md, "History after the upscaler"), lanes 7-9 are this pass's
// previous output at the pixel's previous position, centred as before the upscaler: at the same pixel (mode
// 1, zero motion) or where the GPU's optical flow says the pixel was (mode 2, with native_preprocess.comp's
// five-tap Catmull-Rom filter), rejected (the proxy, blend weight 0) where the frame changed there by more
// than the threshold since the previous frame or the previous position is off screen. The reprojected value
// and whether it was kept go to the composite (`Reproj`), which blends toward it.
layout(local_size_x = 8, local_size_y = 8) in;

// The pass's input: one packed RGBA8 (or BGRA8) texel per pixel, rows of the valid width (the frame's proxy,
// or the previous pass's answer for every pass after the first).
layout(set = 0, binding = 0, std430) readonly buffer Proxy { uint texel[]; } u_proxy;
// f32 [field][16] as 4 x vec4 per pixel.
layout(set = 0, binding = 1, std430) writeonly buffer Features { vec4 features[]; } u_features;
// This pass's previous output (the composite's history, RGB whatever the proxy's channel order), valid
// extent: packHalf2x16(r, g), packHalf2x16(b, 1).
layout(set = 0, binding = 3, std430) readonly buffer History { uvec2 texel[]; } u_history;
// The reprojected history for the composite, valid extent: as History, with the second half of .y 1 where
// the history is kept and 0 where it is not.
layout(set = 0, binding = 4, std430) writeonly buffer Reproj { uvec2 texel[]; } u_reproj;
// The frame's proxy and the previous frame's (the rejection compares them; every pass reads the frame's).
layout(set = 0, binding = 5, std430) readonly buffer Frame { uint texel[]; } u_frame;
layout(set = 0, binding = 6, std430) readonly buffer Previous { uint texel[]; } u_previous;
// The optical flow (mode 2): one vector per grid cell (p.frame.w pixels square), rows of ceil(width / grid),
// two signed 16-bit S10.5 values (x low, y high: pixels x 32) from where the pixel is to where it was.
layout(set = 0, binding = 7, std430) readonly buffer Flow { uint v[]; } u_flow;

layout(push_constant) uniform Params {
  uvec4 dims;      // field width, field height, valid width, valid height
  uvec4 frame;     // seed, BGRA (1) or RGBA (0), history mode (0 none, 1 zero motion, 2 optical flow), flow grid
  vec4 control;    // style, local tone, local structure, skin structure (< 0: follow structure)
  vec4 more;       // auto mask (> 0 on), rejection threshold (0-1), unused x2
} p;

float roundF16(float value) {
  uint bits = floatBitsToUint(value);
  uint sign = bits & 0x80000000u;
  uint magnitude = bits & 0x7fffffffu;
  if (magnitude >= 0x7f800000u) return value;
  if (magnitude >= 0x477ff000u) return uintBitsToFloat(sign | 0x7f800000u);
  if (magnitude < 0x38800000u) {
    float scaled = roundEven(uintBitsToFloat(magnitude) * 16777216.0);
    return uintBitsToFloat(sign) + uintBitsToFloat(sign | floatBitsToUint(scaled * 0.000000059604644775390625));
  }
  uint lsb = (magnitude >> 13u) & 1u;
  uint rounded = (magnitude + 0xfffu + lsb) & ~0x1fffu;
  return uintBitsToFloat(sign | rounded);
}

float hashUniform(uint value) {
  uint mixed = value;
  mixed = (mixed >> ((mixed >> 28u) + 4u)) ^ mixed;
  mixed *= 0x108ef2d9u;
  uint integer = ((mixed >> 30u) ^ (mixed >> 8u)) + 1u;
  return float(integer) * uintBitsToFloat(0x33800000u);
}

vec3 gaussian3(uint x, uint y, uint seed) {
  uint base = (x * 0x8da6b343u) ^ (y * 0xd8163841u) ^ (seed * 0x9e3779b9u) ^ 0x243f6a88u;
  base = (base >> ((base >> 28u) + 4u)) ^ base;
  base *= 0x108ef2d9u;
  base = (base >> 22u) ^ base;
  float u0 = hashUniform(base * 0x2c9277b5u + 0xac564b05u);
  float u1 = hashUniform(base * 0xfa6dc5f9u + 0x4712a88eu);
  float u2 = hashUniform(base * 0xcaa5b80du + 0x21dd796bu);
  float u3 = hashUniform(base * 0x83232c31u + 0x3463e0acu);
  float radius0 = sqrt(log2(u0) * uintBitsToFloat(0x3f317218u) * -2.0);
  float radius1 = sqrt(log2(u2) * uintBitsToFloat(0x3f317218u) * -2.0);
  float tau = uintBitsToFloat(0x40c90fdbu);
  return vec3(roundF16(radius0 * cos(u1 * tau)), roundF16(radius0 * sin(u1 * tau)), roundF16(radius1 * cos(u3 * tau)));
}

vec3 centre(vec3 v) {
  return vec3(roundF16(roundF16(roundF16(v.r) - 0.5) * 0.125), roundF16(roundF16(roundF16(v.g) - 0.5) * 0.125),
              roundF16(roundF16(roundF16(v.b) - 0.5) * 0.125));
}

// The history texel at integer pixel `at` (valid extent).
vec3 historyTexel(ivec2 at) {
  uvec2 t = u_history.texel[uint(at.y) * p.dims.z + uint(at.x)];
  return vec3(unpackHalf2x16(t.x), unpackHalf2x16(t.y).x);
}

// A linear, clamp-to-edge sampler's read of the history at `position` (pixels, centre convention): what
// native_preprocess.comp's textureLod reads from its history image.
vec3 historyBilinear(vec2 position) {
  ivec2 last = ivec2(p.dims.zw) - 1;
  vec2 q = position - 0.5;
  vec2 low = floor(q);
  vec2 f = q - low;
  ivec2 a = clamp(ivec2(low), ivec2(0), last);
  ivec2 b = clamp(ivec2(low) + 1, ivec2(0), last);
  vec3 top = mix(historyTexel(a), historyTexel(ivec2(b.x, a.y)), f.x);
  vec3 bottom = mix(historyTexel(ivec2(a.x, b.y)), historyTexel(b), f.x);
  return mix(top, bottom, f.y);
}

// native_preprocess.comp's historySample (OpenDLSS-NR's five-tap Catmull-Rom) at `position`, with its
// texture coordinates in pixels.
vec3 historySample(vec2 position) {
  vec2 valid = vec2(p.dims.zw);
  vec2 base = floor(position - 0.5) + 0.5;
  vec2 f = clamp(position - base, vec2(0.0), vec2(1.0));
  vec2 square = f * f; vec2 cube = f * square;
  vec2 w0 = fma(f + cube, vec2(-0.5), square);
  vec2 w1 = (cube * 1.5 - square * 2.5) + 1.0;
  vec2 w3 = (cube - square) * 0.5;
  vec2 w2 = ((1.0 - w0) - w1) - w3;
  vec2 middle = w1 + w2;
  vec2 low = clamp(base - 1.0, vec2(0.5), valid - 0.5);
  vec2 center = clamp(base + w2 / middle, vec2(0.5), valid - 0.5);
  vec2 high = clamp(base + 2.0, vec2(0.5), valid - 0.5);
  vec3 left = historyBilinear(vec2(low.x, center.y));
  vec3 top = historyBilinear(vec2(center.x, low.y));
  vec3 mid = historyBilinear(center);
  vec3 bottom = historyBilinear(vec2(center.x, high.y));
  vec3 right = historyBilinear(vec2(high.x, center.y));
  float a = w0.x * middle.y; float b = w0.y * middle.x;
  float c = middle.x * middle.y; float d = w3.y * middle.x; float e = w3.x * middle.y;
  vec3 value = fma(left, vec3(a), top * b);
  value = fma(mid, vec3(c), value);
  value = fma(bottom, vec3(d), value);
  value = fma(right, vec3(e), value);
  return value * (1.0 / (e + (d + (c + (a + b)))));
}

vec2 flowVector(int at) {
  uint bits = u_flow.v[at];
  return vec2(float(int(bits << 16u) >> 16), float(int(bits) >> 16)) * (1.0 / 32.0);
}

// The optical flow at pixel `xy`, interpolated between the grid cells' centres.
vec2 flowAt(uvec2 xy) {
  uint grid = max(p.frame.w, 1u);
  ivec2 cells = ivec2((p.dims.zw + grid - 1u) / grid);
  vec2 q = (vec2(xy) + 0.5) / float(grid) - 0.5;
  vec2 low = floor(q);
  vec2 f = clamp(q - low, vec2(0.0), vec2(1.0));
  ivec2 a = clamp(ivec2(low), ivec2(0), cells - 1);
  ivec2 b = clamp(ivec2(low) + 1, ivec2(0), cells - 1);
  vec2 top = mix(flowVector(a.y * cells.x + a.x), flowVector(a.y * cells.x + b.x), f.x);
  vec2 bottom = mix(flowVector(b.y * cells.x + a.x), flowVector(b.y * cells.x + b.x), f.x);
  return mix(top, bottom, f.y);
}

vec3 rgb(uint texel) { return unpackUnorm4x8(texel).rgb; }

vec3 previousTexel(ivec2 at) { return rgb(u_previous.texel[uint(at.y) * p.dims.z + uint(at.x)]); }

// The previous frame's proxy at `position` (pixels, centre convention), bilinear and clamped to the edge.
vec3 previousFrame(vec2 position) {
  ivec2 last = ivec2(p.dims.zw) - 1;
  vec2 q = position - 0.5;
  vec2 low = floor(q);
  vec2 f = q - low;
  ivec2 a = clamp(ivec2(low), ivec2(0), last);
  ivec2 b = clamp(ivec2(low) + 1, ivec2(0), last);
  vec3 top = mix(previousTexel(a), previousTexel(ivec2(b.x, a.y)), f.x);
  vec3 bottom = mix(previousTexel(ivec2(a.x, b.y)), previousTexel(b), f.x);
  return mix(top, bottom, f.y);
}

// The pass's previous output where pixel `xy` was in the previous frame, and 1 where it is kept (0: no
// history there).
vec4 previous(uvec2 xy) {
  vec2 valid = vec2(p.dims.zw);
  vec2 position = vec2(xy) + 0.5;
  if (p.frame.z == 2u) position += flowAt(xy);
  if (any(lessThan(position, vec2(0.0))) || any(greaterThanEqual(position, valid))) return vec4(0.0);
  // The rejection: the frame here against the previous frame where the pixel was (bilinear; the same pixel
  // with zero motion), in the encoded 0-1 scale, the largest channel difference (the channel order does not
  // matter: both are one format).
  vec3 change = abs(rgb(u_frame.texel[xy.y * p.dims.z + xy.x]) - previousFrame(position));
  if (max(change.r, max(change.g, change.b)) > p.more.y) return vec4(0.0);
  return vec4(p.frame.z == 1u ? historyTexel(ivec2(xy)) : historySample(position), 1.0);
}

void main() {
  uvec2 id = gl_GlobalInvocationID.xy;
  if (id.x >= p.dims.x || id.y >= p.dims.y) return;
  int reflectedX = id.x < p.dims.z ? int(id.x) : 2 * int(p.dims.z) - int(id.x) - 2;
  int reflectedY = id.y < p.dims.w ? int(id.y) : 2 * int(p.dims.w) - int(id.y) - 2;
  uvec2 source = uvec2(clamp(reflectedX, 0, int(p.dims.z) - 1), clamp(reflectedY, 0, int(p.dims.w) - 1));
  vec4 texel = unpackUnorm4x8(u_proxy.texel[source.y * p.dims.z + source.x]);
  vec3 proxy = p.frame.y != 0u ? texel.bgr : texel.rgb;
  vec3 centered = centre(proxy);
  uint base = (id.y * p.dims.x + id.x) * 4u;
  u_features.features[base + 0u] = vec4(gaussian3(id.x, id.y, p.frame.x), 1.0);
  float autoMask = p.more.x;
  float structure = p.control.z;
  float skin = p.control.w;
  vec3 history = centered;
  if (p.frame.z != 0u) {
    // The padding mirrors the history as it mirrors the proxy; the composite reads the valid extent.
    vec4 kept = previous(source);
    if (kept.a > 0.0) history = centre(kept.rgb);
    if (id.x < p.dims.z && id.y < p.dims.w) u_reproj.texel[id.y * p.dims.z + id.x] = uvec2(packHalf2x16(kept.rg), packHalf2x16(kept.ba));
  }
  u_features.features[base + 1u] = vec4(centered, history.r);
  u_features.features[base + 2u] = vec4(history.g, history.b, p.control.x / 128.0, roundF16(p.control.y));
  u_features.features[base + 3u] = vec4(roundF16(autoMask > 0.0 ? 1.0 : structure),
                                        roundF16(autoMask > 0.0 ? (skin < 0.0 ? structure : skin) : -1.0),
                                        roundF16(autoMask > 0.0 ? structure : -1.0), 0.0);
}
