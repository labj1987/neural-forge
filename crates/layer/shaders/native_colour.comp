#version 450
// The colour of the edit before the upscaler (docs/NATIVE_BACKEND.md, "The colour of the edit"): after a
// pass's composite, its answer is reshaped through its change from the pass's input (the edit e = answer -
// input, in the encoded domain native_composite.comp works in), in place in the answer buffer:
//   detail      e = low + detail x (e - low), low the edit's 3x3 binomial blur (phase 0 writes it);
//   saturation  and contrast: e = contrast x l + saturation x (e - l), l = the edit's BT.709 luma (a grey
//               change), e - l its chroma (a change of no luma);
//   protect     the result's Oklab hue turned toward the input's, a near-grey input's chroma kept, darkening of
//               shadows and brightening of highlights held back (p.protect, 0-1 each; see protectResult);
//   look-up     on the last pass, r = mix(r, LUT(r), strength x min(1, |e|max / adapt)): a pixel the
//               network left alone keeps its colour;
//   gamut guard where input + e leaves 0-1 in a channel, e is shortened along itself until it fits (the
//               change keeps its hue; the encode maps linear 0 to 0, so below 0 is outside BT.709's
//               primaries and above 1 past the shoulder's top).
// Each step runs only when its value moves it (p.colour_flags.x bit 1 says the pass has one), so a neutral
// pass's answer is not touched at all, bit for bit. The history (u_next) is the composite's: never reshaped.
//
// It works at the render extent on the pass's full-size answer and input (bindings 12 and 15, which a pass
// below the render extent also binds: it runs after that pass's enlarge), p.full giving the extent and the
// padded width. Two pipelines (constant_id 1, PHASE): 0 writes the edit's low-pass for the detail step into
// u_low, 1 applies the steps. The descriptor set layout and Params are native_preprocess.comp's (field for field,
// append only).
layout(local_size_x = 8, local_size_y = 8) in;

layout(constant_id = 1) const uint PHASE = 0u;
// The pass's input at the render extent (padded), GENERAL.
layout(set = 0, binding = 12, rgba16f) uniform readonly image2D u_encoded;
layout(set = 0, binding = 4, std140) uniform Params {
  uvec4 dims;        // field width, field height, valid width, valid height
  uvec4 frame;       // padded width, seed, history valid (CPU), parity
  vec4 motion;
  vec4 control;
  vec4 more;
  uvec4 mask;
  vec4 sky;
  vec4 dark;
  vec4 moving;
  uvec4 full;        // the render extent (width, height), its padded width, the depth copy's kind
  vec4 ratio;        // the pass's extent over the render extent (x, y), the enlarge's guide sigma, unused
  vec4 colour;       // the edit's saturation, contrast, detail, unused
  uvec4 colour_flags; // 1 a step runs, 2 gamut guard, 4 look-up table, 8 detail; table size; unused x2
  vec4 lut_scale;    // per channel (size - 1) / (domain max - min); strength
  vec4 lut_offset;   // per channel -domain min x scale; adapt (the edit size at full strength)
  vec4 protect;      // the protections: hue, near-grey chroma, shadow, highlight (0-1; appended, this shader only)
} p;
// The answer at the render extent, RGBA16F rows of the padded width as packed half4 (native_composite.comp's,
// or native_enlarge.comp's).
layout(set = 0, binding = 15, std430) buffer Answer { uvec2 texel[]; } u_answer;
// The edit's low-pass, valid extent (phase 0 writes, phase 1 reads).
layout(set = 0, binding = 16, std430) buffer Low { vec4 low[]; } u_low;
// The look-up table: size^3 RGB entries, red fastest.
layout(set = 0, binding = 17, std430) readonly buffer Lut { vec4 entry[]; } u_lut;

const uint STEP = 1u;
const uint GUARD = 2u;
const uint LUT = 4u;
const uint DETAIL = 8u;
const uint PROTECT = 32u;
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

float truncateHalf(float value) {
  uint bits = floatBitsToUint(value);
  uint signBit = (bits >> 16u) & 0x8000u;
  uint exponent = (bits >> 23u) & 0xffu;
  uint mantissa = bits & 0x7fffffu;
  uint halfBits;
  if (exponent == 0xffu) {
    halfBits = signBit | (mantissa != 0u ? 0x7e00u : 0x7c00u);
  } else {
    int halfExponent = int(exponent) - 112;
    if (halfExponent >= 31) halfBits = signBit | 0x7c00u;
    else if (halfExponent <= 0) {
      if (halfExponent < -10) halfBits = signBit;
      else halfBits = signBit | ((mantissa | 0x800000u) >> uint(14 - halfExponent));
    } else halfBits = signBit | (uint(halfExponent) << 10u) | (mantissa >> 13u);
  }
  return unpackHalf2x16(halfBits).x;
}

// The protections of a pass's result r against its input (docs/NATIVE_BACKEND.md, "The colour of the edit";
// `k`: hue, near-grey chroma, shadow, highlight, each 0-1), in Oklab (Bjorn Ottosson, public domain,
// https://bottosson.github.io/posts/oklab/) of the values read as sRGB-encoded. The idea of protecting the
// network's result in a perceptual space comes from Veyra-NRVideo / Magpie Experimental; these rules are this
// project's own. Out-of-range values stay out of range (the sRGB curve's linear and power parts extend), so the
// gamut guard after it still shortens the change instead of clipping a channel.
float srgbToLinear(float s) {
  float a = abs(s);
  float l = a <= 0.04045 ? a / 12.92 : pow((a + 0.055) / 1.055, 2.4);
  return s < 0.0 ? -l : l;
}
float linearToSrgb(float l) {
  float a = abs(l);
  float s = a <= 0.0031308 ? 12.92 * a : 1.055 * pow(a, 1.0 / 2.4) - 0.055;
  return l < 0.0 ? -s : s;
}
float cbrtSigned(float x) {
  return x < 0.0 ? -pow(-x, 1.0 / 3.0) : pow(x, 1.0 / 3.0);
}
vec3 toOklab(vec3 c) {
  float l = cbrtSigned(0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b);
  float m = cbrtSigned(0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b);
  float s = cbrtSigned(0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b);
  return vec3(0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
              1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
              0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s);
}
vec3 fromOklab(vec3 c) {
  float l = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z;
  float m = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z;
  float s = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z;
  l = l * l * l;
  m = m * m * m;
  s = s * s * s;
  return vec3(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
              -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
              -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
}
// Where the input's chroma is this low (Oklab) its hue means nothing and the near-grey protection takes over;
// above GREY_HI the hue protection applies in full.
const float GREY_LO = 0.01;
const float GREY_HI = 0.04;
vec3 protectResult(vec3 input_, vec3 r, vec4 k) {
  vec3 li = vec3(srgbToLinear(input_.r), srgbToLinear(input_.g), srgbToLinear(input_.b));
  vec3 lr = vec3(srgbToLinear(r.r), srgbToLinear(r.g), srgbToLinear(r.b));
  vec3 oi = toOklab(li);
  vec3 o = toOklab(lr);
  float ci = length(oi.yz);
  float cr = length(o.yz);
  float colourful = smoothstep(GREY_LO, GREY_HI, ci);
  // Hue: the result's chroma and lightness, its hue turned toward the input's (the shorter way).
  if (k.x > 0.0 && ci > 1e-5 && cr > 1e-5) {
    vec2 di = oi.yz / ci;
    vec2 dr = o.yz / cr;
    float w = k.x * colourful;
    float cosA = clamp(dot(dr, di), -1.0, 1.0);
    float angle = acos(cosA) * w;
    float side = (dr.x * di.y - dr.y * di.x) < 0.0 ? -1.0 : 1.0;
    float ca = cos(angle * side);
    float sa = sin(angle * side);
    o.yz = cr * vec2(dr.x * ca - dr.y * sa, dr.x * sa + dr.y * ca);
  }
  // Near grey: a colour that was (almost) neutral keeps its own chroma, so the network adds no tint.
  if (k.y > 0.0) o.yz = mix(o.yz, oi.yz, k.y * (1.0 - colourful));
  // Shadows: darkening of a dark input is held back (Oklab lightness 0.3 and below in full, none from 0.5).
  if (k.z > 0.0 && o.x < oi.x) o.x = mix(o.x, oi.x, k.z * (1.0 - smoothstep(0.3, 0.5, oi.x)));
  // Highlights: brightening of a bright input is held back (none up to 0.75, full from 0.92).
  if (k.w > 0.0 && o.x > oi.x) o.x = mix(o.x, oi.x, k.w * smoothstep(0.75, 0.92, oi.x));
  vec3 lo = fromOklab(o);
  return vec3(linearToSrgb(lo.r), linearToSrgb(lo.g), linearToSrgb(lo.b));
}

vec4 answerAt(uvec2 xy) {
  uvec2 t = u_answer.texel[xy.y * p.full.z + xy.x];
  return vec4(unpackHalf2x16(t.x), unpackHalf2x16(t.y));
}

vec3 editAt(ivec2 xy) {
  uvec2 at = uvec2(clamp(xy, ivec2(0), ivec2(p.full.xy) - 1));
  return answerAt(at).rgb - imageLoad(u_encoded, ivec2(at)).rgb;
}

vec3 lutEntry(uint r, uint g, uint b) {
  uint n = p.colour_flags.y;
  return u_lut.entry[r + n * (g + n * b)].rgb;
}

// Trilinear, as `neural_forge_protocol::cube::Cube::sample`.
vec3 lutSample(vec3 rgb) {
  float last = float(p.colour_flags.y - 1u);
  vec3 t = clamp(rgb * p.lut_scale.xyz + p.lut_offset.xyz, vec3(0.0), vec3(last));
  uvec3 b = uvec3(min(floor(t), vec3(last - 1.0)));
  vec3 f = t - vec3(b);
  vec3 c00 = mix(lutEntry(b.x, b.y, b.z), lutEntry(b.x + 1u, b.y, b.z), f.x);
  vec3 c10 = mix(lutEntry(b.x, b.y + 1u, b.z), lutEntry(b.x + 1u, b.y + 1u, b.z), f.x);
  vec3 c01 = mix(lutEntry(b.x, b.y, b.z + 1u), lutEntry(b.x + 1u, b.y, b.z + 1u), f.x);
  vec3 c11 = mix(lutEntry(b.x, b.y + 1u, b.z + 1u), lutEntry(b.x + 1u, b.y + 1u, b.z + 1u), f.x);
  return mix(mix(c00, c10, f.y), mix(c01, c11, f.y), f.z);
}

void main() {
  uvec2 id = gl_GlobalInvocationID.xy;
  if (id.x >= p.full.x || id.y >= p.full.y) return;
  uint flags = p.colour_flags.x;
  if ((flags & STEP) == 0u) return;
  if (PHASE == 0u) {
    if ((flags & DETAIL) == 0u) return;
    ivec2 c = ivec2(id);
    vec3 sum = vec3(0.0);
    for (int dy = -1; dy <= 1; dy++) {
      for (int dx = -1; dx <= 1; dx++) {
        float w = float((2 - abs(dx)) * (2 - abs(dy)));
        sum += w * editAt(c + ivec2(dx, dy));
      }
    }
    u_low.low[id.y * p.full.x + id.x] = vec4(sum * (1.0 / 16.0), 0.0);
    return;
  }
  vec4 a = answerAt(id);
  vec3 input_ = clamp(imageLoad(u_encoded, ivec2(id)).rgb, vec3(0.0), vec3(1.0));
  vec3 e = a.rgb - input_;
  vec3 r = a.rgb;
  bool changed = false;
  if ((flags & DETAIL) != 0u) {
    vec3 low = u_low.low[id.y * p.full.x + id.x].rgb;
    e = low + p.colour.z * (e - low);
    changed = true;
  }
  if (p.colour.x != 1.0 || p.colour.y != 1.0) {
    float l = dot(e, LUMA);
    vec3 chroma = e - vec3(l);
    e = p.colour.y * vec3(l) + p.colour.x * chroma;
    changed = true;
  }
  if (changed) r = input_ + e;
  if ((flags & PROTECT) != 0u) {
    r = protectResult(input_, r, p.protect);
    changed = true;
  }
  if ((flags & LUT) != 0u) {
    vec3 d = abs(r - input_);
    float size = max(d.r, max(d.g, d.b));
    float w = p.lut_scale.w * min(1.0, size / p.lut_offset.w);
    if (w > 0.0) {
      r = mix(r, lutSample(clamp(r, vec3(0.0), vec3(1.0))), w);
      changed = true;
    }
  }
  if (!changed) return;
  if ((flags & GUARD) != 0u) {
    vec3 d = r - input_;
    float t = 1.0;
    for (int c = 0; c < 3; c++) {
      if (r[c] > 1.0) t = min(t, (1.0 - input_[c]) / d[c]);
      else if (r[c] < 0.0) t = min(t, -input_[c] / d[c]);
    }
    if (t < 1.0) r = input_ + max(t, 0.0) * d;
  }
  vec3 published;
  for (int c = 0; c < 3; c++) published[c] = truncateHalf(clamp(r[c], 0.0, 1.0));
  uvec2 texel = uvec2(packHalf2x16(published.rg), packHalf2x16(vec2(published.b, a.a)));
  u_answer.texel[id.y * p.full.z + id.x] = texel;
  // The padding repeats the edge, as the composite's does.
  uvec2 padded_size = uvec2(p.full.z, p.full.y + (p.full.y & 1u));
  bool right = id.x + 1u == p.full.x && id.x + 1u < padded_size.x;
  bool below = id.y + 1u == p.full.y && id.y + 1u < padded_size.y;
  if (right) u_answer.texel[id.y * p.full.z + id.x + 1u] = texel;
  if (below) u_answer.texel[(id.y + 1u) * p.full.z + id.x] = texel;
  if (right && below) u_answer.texel[(id.y + 1u) * p.full.z + id.x + 1u] = texel;
}
