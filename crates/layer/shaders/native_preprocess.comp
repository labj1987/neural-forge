#version 450
// The native backend's input features (docs/NATIVE_BACKEND.md, "Phase 1"): the network's 16 f32 lanes per
// pixel of its padded field, from the layer's encoded proxy, the reprojected previous output and the
// conditioning. Ported from OpenDLSS-NR's demo/shaders/nr_preprocess.comp and nr_common.glsl (MIT,
// commit 9d08f41): the lane layout, the half roundings, the noise hash and the five-tap Catmull-Rom
// history filter are theirs and must stay bit-for-bit as they are. What differs is where the inputs
// come from: the proxy is preupscale_encode.comp's output (already on the half grid), and the
// previous position of a pixel is DLSS's motion vector plus the change of the camera jitter
// (prev = x + mv + jitter[t-1] - jitter[t], render pixels; NATIVE_BACKEND.md, "Motion vectors").
//
// The descriptor set layout and Params are shared with native_composite.comp and
// `preupscale::native::Params` (field for field, append only). The common functions are duplicated
// there (no include: scripts/check_shaders.py hashes .comp files only).
layout(local_size_x = 8, local_size_y = 8) in;

// The encoded proxy (padded extent), GENERAL.
layout(set = 0, binding = 0, rgba16f) uniform readonly image2D u_encoded;
// The previous frame's output on the half grid, valid extent (linear sampler, clamp to edge).
layout(set = 0, binding = 1) uniform sampler2D u_history;
// DLSS's motion vectors, valid extent, one packed half2 per texel (render pixels, current -> previous).
layout(set = 0, binding = 2, std430) readonly buffer Motion { uint mv[]; } u_motion;
// f32 [field][16] as 4 x vec4 per pixel.
layout(set = 0, binding = 3, std430) writeonly buffer Features { vec4 features[]; } u_features;
layout(set = 0, binding = 4, std140) uniform Params {
  uvec4 dims;        // field width, field height, valid width, valid height
  uvec4 frame;       // padded width, seed, history valid (CPU), parity
  vec4 motion;       // jitter[t-1] - jitter[t] (x, y), blend scale, intensity
  vec4 control;      // style, local tone, local structure, skin structure (< 0: follow structure)
  vec4 more;         // auto mask (> 0 on), unused x3
} p;
// [0], [1]: whether the frame of that parity was encoded with a usable exposure (written by the composite).
layout(set = 0, binding = 5, std430) buffer State { uint ok[2]; } u_state;

float roundF16(float value) {
  uint bits = floatBitsToUint(value);
  uint sign = bits & 0x80000000u;
  uint magnitude = bits & 0x7fffffffu;
  if (magnitude >= 0x7f800000u) return value;
  if (magnitude >= 0x477ff000u) return uintBitsToFloat(sign | 0x7f800000u);
  if (magnitude < 0x38800000u) {
    float scaled = roundEven(uintBitsToFloat(magnitude) * 16777216.0);
    return uintBitsToFloat(sign) + uintBitsToFloat(sign | floatBitsToUint(scaled * 0.000000059604644775390625));
  }
  uint lsb = (magnitude >> 13u) & 1u;
  uint rounded = (magnitude + 0xfffu + lsb) & ~0x1fffu;
  return uintBitsToFloat(sign | rounded);
}

float hashUniform(uint value) {
  uint mixed = value;
  mixed = (mixed >> ((mixed >> 28u) + 4u)) ^ mixed;
  mixed *= 0x108ef2d9u;
  uint integer = ((mixed >> 30u) ^ (mixed >> 8u)) + 1u;
  return float(integer) * uintBitsToFloat(0x33800000u);
}

vec3 gaussian3(uint x, uint y, uint seed) {
  uint base = (x * 0x8da6b343u) ^ (y * 0xd8163841u) ^ (seed * 0x9e3779b9u) ^ 0x243f6a88u;
  base = (base >> ((base >> 28u) + 4u)) ^ base;
  base *= 0x108ef2d9u;
  base = (base >> 22u) ^ base;
  float u0 = hashUniform(base * 0x2c9277b5u + 0xac564b05u);
  float u1 = hashUniform(base * 0xfa6dc5f9u + 0x4712a88eu);
  float u2 = hashUniform(base * 0xcaa5b80du + 0x21dd796bu);
  float u3 = hashUniform(base * 0x83232c31u + 0x3463e0acu);
  float radius0 = sqrt(log2(u0) * uintBitsToFloat(0x3f317218u) * -2.0);
  float radius1 = sqrt(log2(u2) * uintBitsToFloat(0x3f317218u) * -2.0);
  float tau = uintBitsToFloat(0x40c90fdbu);
  return vec3(roundF16(radius0 * cos(u1 * tau)), roundF16(radius0 * sin(u1 * tau)), roundF16(radius1 * cos(u3 * tau)));
}

// Where pixel `xy` was in the previous frame, in pixels (centre convention).
vec2 previousPosition(uvec2 xy) {
  vec2 mv = unpackHalf2x16(u_motion.mv[xy.y * p.dims.z + xy.x]);
  return vec2(xy) + 0.5 + mv + p.motion.xy;
}

// The previous frame showed this pixel: its previous position is inside the frame, the CPU has a
// history for this frame and the previous frame's exposure was usable.
bool hasHistory(uvec2 xy) {
  if (p.frame.z == 0u || u_state.ok[1u - p.frame.w] == 0u) return false;
  vec2 at = previousPosition(xy);
  vec2 valid = vec2(p.dims.zw);
  return all(greaterThanEqual(at, vec2(0.0))) && all(lessThan(at, valid));
}

// OpenDLSS-NR's historySample, with the position computed here.
vec3 historySample(uvec2 xy) {
  vec2 valid = vec2(p.dims.zw);
  vec2 position = previousPosition(xy);
  vec2 base = floor(position - 0.5) + 0.5;
  vec2 f = clamp(position - base, vec2(0.0), vec2(1.0));
  vec2 square = f * f; vec2 cube = f * square;
  vec2 w0 = fma(f + cube, vec2(-0.5), square);
  vec2 w1 = (cube * 1.5 - square * 2.5) + 1.0;
  vec2 w3 = (cube - square) * 0.5;
  vec2 w2 = ((1.0 - w0) - w1) - w3;
  vec2 middle = w1 + w2;
  vec2 low = clamp(base - 1.0, vec2(0.5), valid - 0.5) / valid;
  vec2 center = clamp(base + w2 / middle, vec2(0.5), valid - 0.5) / valid;
  vec2 high = clamp(base + 2.0, vec2(0.5), valid - 0.5) / valid;
  vec3 left = textureLod(u_history, vec2(low.x, center.y), 0.0).rgb;
  vec3 top = textureLod(u_history, vec2(center.x, low.y), 0.0).rgb;
  vec3 mid = textureLod(u_history, center, 0.0).rgb;
  vec3 bottom = textureLod(u_history, vec2(center.x, high.y), 0.0).rgb;
  vec3 right = textureLod(u_history, vec2(high.x, center.y), 0.0).rgb;
  float a = w0.x * middle.y; float b = w0.y * middle.x;
  float c = middle.x * middle.y; float d = w3.y * middle.x; float e = w3.x * middle.y;
  vec3 value = fma(left, vec3(a), top * b);
  value = fma(mid, vec3(c), value);
  value = fma(bottom, vec3(d), value);
  value = fma(right, vec3(e), value);
  return value * (1.0 / (e + (d + (c + (a + b)))));
}

vec3 centre(vec3 v) {
  return vec3(roundF16(roundF16(roundF16(v.r) - 0.5) * 0.125), roundF16(roundF16(roundF16(v.g) - 0.5) * 0.125),
              roundF16(roundF16(roundF16(v.b) - 0.5) * 0.125));
}

void main() {
  uvec2 id = gl_GlobalInvocationID.xy;
  if (id.x >= p.dims.x || id.y >= p.dims.y) return;
  // The padding mirrors the image without repeating the edge (network.md, "Geometry").
  int reflectedX = id.x < p.dims.z ? int(id.x) : 2 * int(p.dims.z) - int(id.x) - 2;
  int reflectedY = id.y < p.dims.w ? int(id.y) : 2 * int(p.dims.w) - int(id.y) - 2;
  uvec2 source = uvec2(clamp(reflectedX, 0, int(p.dims.z) - 1), clamp(reflectedY, 0, int(p.dims.w) - 1));
  vec3 proxy = imageLoad(u_encoded, ivec2(source)).rgb;
  vec3 centered = centre(proxy);
  vec3 noise = gaussian3(id.x, id.y, p.frame.y);
  uint base = (id.y * p.dims.x + id.x) * 4u;
  u_features.features[base + 0u] = vec4(noise, 1.0);
  vec3 history = centered;
  if (hasHistory(source)) history = centre(historySample(source));
  float autoMask = p.more.x;
  float structure = p.control.z;
  float skin = p.control.w;
  u_features.features[base + 1u] = vec4(centered, history.r);
  u_features.features[base + 2u] = vec4(history.g, history.b, p.control.x / 128.0, roundF16(p.control.y));
  u_features.features[base + 3u] = vec4(roundF16(autoMask > 0.0 ? 1.0 : structure),
                                        roundF16(autoMask > 0.0 ? (skin < 0.0 ? structure : skin) : -1.0),
                                        roundF16(autoMask > 0.0 ? structure : -1.0), 0.0);
}
