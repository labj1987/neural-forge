#version 450
// The pre-upscaler path's HDR encode (docs/PRE_UPSCALER_DESIGN.md, "E1b: the HDR encode" and
// "Implementation (layer)"): turns DLSS's scene-linear, pre-exposure RGBA16F colour input into the
// display-referred [0, 1] picture the model expects, at the padded size the network runs on.
//
// Per channel: v = max(scene, 0) * e / paper_white (e: the game's 1x1 R16_SFLOAT exposure value,
// multiplied in); above 0.75 the shoulder 0.75 + 0.25 * (1 - exp(-K * (v - 0.75))); then the sRGB
// OETF. With flags bit 2 (ACES, RTX Remix's transfer) instead: x = min(max(scene, 0), 65504) * e * ACES_WHITE /
// paper_white, Narkowicz's ACES fit of x saturated, then the sRGB OETF (Remix's tonemapping_fast_tonemapping.comp.slang,
// MIT, see ATTRIBUTION.md). Alpha is 1. Padding: an invocation outside the real extent reads the nearest edge texel, so
// the padding column/row duplicates the last column/row (as the raw copy's regions do).
//
// The descriptor set layout and the push constants are shared with preupscale_decode.comp and must
// stay identical in both shaders and in `preupscale::hdr::HdrPush` (field for field, append only).
// The curve functions are duplicated in preupscale_decode.comp (no include: scripts/check_shaders.py
// hashes .comp files only) and must stay the same functions as the CPU reference in
// `preupscale::tests::hdr_ref`.
layout(local_size_x = 8, local_size_y = 8) in;

// The game's colour input, in GENERAL. Only read here.
layout(set = 0, binding = 0, rgba16f) uniform readonly image2D u_colour;
// The encoded picture, padded extent, GENERAL. Copied to the proxy region afterwards, and read by
// the decode for the clamped-highlight rule.
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D u_encoded;
// The exposure texel (R16_SFLOAT, copied in by the capture's transfer), in the low 16 bits.
layout(set = 0, binding = 2, std430) readonly buffer Exposure {
  uint bits;
} u_exposure;
// binding 3 (the answer image) is the decode's only.

layout(push_constant) uniform Params {
  uvec2 size;        // the colour input's extent
  uvec2 padded;      // the proxy's extent (even)
  float paper_white; // exposed units that map to 1.0 before the shoulder
  uint flags;        // bit 0: keep clamped highlights (decode only); bit 1: linear (no sRGB OETF); bit 2: ACES
} p;

const uint LINEAR = 2u;
const uint ACES = 4u;
// The ACES transfer's exposure is e * ACES_WHITE / paper_white: Remix's x = hdr * exposure at the default paper
// white (preupscale::hdr::ACES_WHITE).
const float ACES_WHITE = 3.0;
const float HALF_MAX = 65504.0;

const float KNEE = 0.75;
const float K = 5.770780;

// A usable exposure value: finite and clearly positive. Otherwise the CPU skips the write-back and
// the decode leaves every pixel alone.
bool exposure_ok(float e) {
  return e > 1e-6 && e < 65504.0;
}

float shoulder(float v) {
  return v <= KNEE ? v : KNEE + 0.25 * (1.0 - exp(-K * (v - KNEE)));
}

float srgb_oetf(float c) {
  c = clamp(c, 0.0, 1.0);
  return c <= 0.0031308 ? 12.92 * c : 1.055 * pow(c, 1.0 / 2.4) - 0.055;
}

// Narkowicz's ACES fit (Remix's ACESFilmApproximation), saturated.
float aces(float x) {
  return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

// The ACES transfer: Remix's sanitizeRadiance (NaN and infinities 0, within [0, 65504]), the exposure, the curve,
// sRGB. An unusable exposure (scale 0) encodes 0.
float aces_encode(float scene, float scale) {
  float x = isnan(scene) || isinf(scene) ? 0.0 : clamp(scene, 0.0, HALF_MAX);
  return srgb_oetf(scale > 0.0 ? aces(x * scale * ACES_WHITE) : 0.0);
}

// scene-linear -> model domain. NaN and negatives are 0; +Inf ends on the shoulder's top (1.0). With an
// unusable exposure (scale 0) every value is 0: +Inf * 0 would be a NaN, and clamp() of one is undefined.
float encode(float scene, float scale) {
  if ((p.flags & ACES) != 0u) {
    return aces_encode(scene, scale);
  }
  float x = scene >= 0.0 ? scene : 0.0;
  float v = shoulder(scale > 0.0 ? x * scale : 0.0);
  return (p.flags & LINEAR) != 0u ? v : srgb_oetf(v);
}

void main() {
  uvec2 xy = gl_GlobalInvocationID.xy;
  if (any(greaterThanEqual(xy, p.padded))) {
    return;
  }
  float e = unpackHalf2x16(u_exposure.bits).x;
  float scale = exposure_ok(e) ? e / p.paper_white : 0.0;
  ivec2 src = ivec2(min(xy, p.size - uvec2(1u)));
  vec3 scene = imageLoad(u_colour, src).rgb;
  imageStore(u_encoded, ivec2(xy), vec4(encode(scene.r, scale), encode(scene.g, scale), encode(scene.b, scale), 1.0));
}
