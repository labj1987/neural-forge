#version 450
#extension GL_EXT_samplerless_texture_functions : require
// Tone maps the model's scene-linear RGBA16F Color image into an 8-bit picture for optical
// flow only (the model itself keeps the raw half floats). Per channel: NaN and negatives to 0,
// Reinhard x / (1 + x), then the sRGB transfer function. Must stay the same function as
// `crates/helper/src/hdr.rs`'s `tonemap_encode` (the CPU scene-cut thumbnail uses that one).
// Output: a full-resolution R8G8B8A8_UNORM storage image the flow input is blitted from.
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform texture2D src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform Params {
    uvec2 size;
} p;

float encode(float x) {
    if (isnan(x) || x <= 0.0) {
        return 0.0;
    }
    if (isinf(x)) {
        return 1.0;
    }
    float c = x / (1.0 + x);
    return c <= 0.0031308 ? 12.92 * c : 1.055 * pow(c, 1.0 / 2.4) - 0.055;
}

void main() {
    uvec2 xy = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(xy, p.size))) {
        return;
    }
    vec3 c = texelFetch(src, ivec2(xy), 0).rgb;
    imageStore(dst, ivec2(xy), vec4(encode(c.r), encode(c.g), encode(c.b), 1.0));
}
