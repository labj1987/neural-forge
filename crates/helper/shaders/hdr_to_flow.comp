#version 450
#extension GL_EXT_samplerless_texture_functions : require
// Quantises the model's RGBA16F Color image (the layer's encoded proxy, already display-referred
// in [0, 1]) into an 8-bit picture for optical flow only (the model itself keeps the half floats).
// Per channel: NaN to 0, then clamped to [0, 1]; no tone map and no transfer function (the layer's
// encode did both). Must stay the same function as `crates/helper/src/hdr.rs`'s `encoded_unit`
// (the CPU scene-cut thumbnail uses that one).
// Output: a full-resolution R8G8B8A8_UNORM storage image the flow input is blitted from.
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform texture2D src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform Params {
    uvec2 size;
} p;

float encode(float x) {
    if (isnan(x)) {
        return 0.0;
    }
    return clamp(x, 0.0, 1.0);
}

void main() {
    uvec2 xy = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(xy, p.size))) {
        return;
    }
    vec3 c = texelFetch(src, ivec2(xy), 0).rgb;
    imageStore(dst, ivec2(xy), vec4(encode(c.r), encode(c.g), encode(c.b), 1.0));
}
